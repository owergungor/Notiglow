# ==============================================================================
# Curry - .gitignore
# ==============================================================================

# Node / Frontend Build & Dependencies
node_modules/
.svelte-kit/
build/
dist/
package/
coverage/
.nyc_output/
*.tsbuildinfo

# Tauri & Rust Build Artifacts
**/target/
**/gen/schemas/
*.pdb

# Installers & Release Binaries (distributed via GitHub Releases)
*.exe
*.msi
*.zip
*.7z
*.rar
*.tar.gz
*.dmg
*.deb
*.appimage

# IDE / Editor Configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# OS-Specific Metadata
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.directory

# Secrets, Credentials & Local Environment
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
*.secret

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# Runtime Local Storage & Data (Do not commit user data)
settings.json
notifications.json
glow_settings.json
profiles.json
*.runtime.json

# ==============================================================================
# Legacy C# / WPF Reference Project (Preserved locally, excluded from repository)
# ==============================================================================
/App.xaml
/App.xaml.cs
/AssemblyInfo.cs
/Assets/
/Core/
/Models/
/NotiGlow-Setup.iss
/NotiGlow.Tests/
/NotiGlow.csproj
/Overlay/
/Program.cs
/Services/
/Tools/
/UI/
/[Bb]in/
/[Oo]bj/
/[Rr]elease/
/[Dd]ebug/
/[Pp]ublish/
/[Tt]estResults/
/Output/
