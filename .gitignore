# ==============================================================================
# NotiGlow - .gitignore
# ==============================================================================

# Build results & compiler outputs
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Pp]ublish/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
[Oo]utput/

# Release distribution archives & packages
release/*.zip
*.zip
*.7z
*.rar
*.msi
*.nupkg

# Visual Studio, Rider & VS Code metadata
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.swp
*~

# Operating System Files
Thumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/
*.directory

# Secrets, Environment & Credentials
.env
.env.*
!*.example
*.pem
*.key
*.cert
*.pfx
*.p12
*.secret

# Runtime local data, diagnostics & temporary files
*.tmp
*.temp
*.log

# Separate project boundaries
tauri/
Curry/
