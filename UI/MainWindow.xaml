<ui:FluentWindow x:Class="GlowBorder.UI.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:views="clr-namespace:GlowBorder.UI.Views"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                  mc:Ignorable="d" 
                  Title="NotiGlow 2.0" Height="760" Width="1140"
                  MinHeight="600" MinWidth="900"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                  Loaded="Window_Loaded"
                  Background="{DynamicResource WindowBackground}">
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="NotiGlow 2.0 — Ambient Notification Utility"
                     Foreground="{DynamicResource TextPrimary}"
                     ButtonsForeground="{DynamicResource TextPrimary}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="AppTitleBarIcon"
                              Source="pack://application:,,,/NotiGlow;component/Assets/NotiGlowLogo.png"
                              Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation View Sidebar Container with Active Selection Overlay -->
            <Grid Grid.Column="0" x:Name="SidebarGrid" Background="{DynamicResource SidebarBackground}">
                <!-- Active Selection Box Overlay (Layer behind items with rounded border & indicator) -->
                <Canvas x:Name="SidebarOverlayCanvas" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="ActiveSelectionBox"
                            CornerRadius="8"
                            Height="40"
                            Background="{DynamicResource NavActiveBackground}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            SnapsToDevicePixels="True">
                        <!-- Sol Aktif Indicator (3px x 24px, CornerRadius 1.5px) -->
                        <Border Width="3"
                                Height="24"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource NavIndicatorColor}"/>
                    </Border>
                </Canvas>

                <!-- Navigation View Sidebar Pane (Base Layer) -->
                <ui:NavigationView x:Name="RootNavigationView"
                                   PaneDisplayMode="Left"
                                   OpenPaneLength="230"
                                   CompactPaneLength="52"
                                   IsPaneOpen="True"
                                   SelectionChanged="RootNavigationView_SelectionChanged"
                                   SizeChanged="RootNavigationView_SizeChanged"
                                   Background="Transparent"
                                   Foreground="{DynamicResource TextSecondary}">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem x:Name="NavItemGeneral" Content="General" Tag="General" Icon="{ui:SymbolIcon Home24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemApplications" Content="Applications" Tag="Applications" Icon="{ui:SymbolIcon Apps24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemAppearance" Content="Appearance" Tag="Appearance" Icon="{ui:SymbolIcon PaintBrush24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemDisplay" Content="Display" Tag="Display" Icon="{ui:SymbolIcon Desktop24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemGaming" Content="Gaming" Tag="Gaming" Icon="{ui:SymbolIcon Games24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemNotifications" Content="Notifications" Tag="Notifications" Icon="{ui:SymbolIcon Alert24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemAdvanced" Content="Advanced" Tag="Advanced" Icon="{ui:SymbolIcon Wrench24}" Click="NavItem_Click"/>
                    </ui:NavigationView.MenuItems>
                </ui:NavigationView>
            </Grid>

            <!-- Single Authoritative Main Views Container (Expands dynamically to fill entire remaining space) -->
            <Grid Grid.Column="1" x:Name="RootContentGrid" Background="{DynamicResource WindowBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <views:GeneralView x:Name="ViewGeneral" Visibility="Visible" HorizontalAlignment="Stretch"/>
                <views:ApplicationsView x:Name="ViewApplications" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                <views:AppearanceView x:Name="ViewAppearance" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                <views:DisplayView x:Name="ViewDisplay" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                <views:GamingView x:Name="ViewGaming" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                <views:NotificationsView x:Name="ViewNotifications" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                <views:AdvancedView x:Name="ViewAdvanced" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
