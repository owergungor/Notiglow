<ui:FluentWindow x:Class="NotiGlow.UI.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:views="clr-namespace:NotiGlow.UI.Views"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                  mc:Ignorable="d" 
                  Title="NotiGlow" Height="760" Width="1140"
                  MinHeight="600" MinWidth="900"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                  Loaded="Window_Loaded"
                  Background="{DynamicResource WindowBackground}">
    <ui:FluentWindow.Resources>
        <Style x:Key="LanguageItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlPressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="NotiGlow — Ambient Notification Utility"
                     Foreground="{DynamicResource TextPrimary}"
                     ButtonsForeground="{DynamicResource TextPrimary}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="AppTitleBarIcon"
                              Source="pack://application:,,,/NotiGlow;component/Assets/NotiGlowLogo.png"
                              Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation View Sidebar Container with Active Selection Overlay -->
            <Grid Grid.Column="0" x:Name="SidebarGrid" Background="{DynamicResource SidebarBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Active Selection Box Overlay (Layer behind items with rounded border & indicator) -->
                <Canvas Grid.Row="0" x:Name="SidebarOverlayCanvas" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="ActiveSelectionBox"
                            CornerRadius="8"
                            Height="40"
                            Background="{DynamicResource NavActiveBackground}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed"
                            SnapsToDevicePixels="True">
                        <!-- Sol Aktif Indicator (3px x 24px, CornerRadius 1.5px) -->
                        <Border Width="3"
                                Height="24"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource NavIndicatorColor}"/>
                    </Border>
                </Canvas>

                <!-- Navigation View Sidebar Pane (Base Layer) -->
                <ui:NavigationView Grid.Row="0" x:Name="RootNavigationView"
                                   PaneDisplayMode="Left"
                                   OpenPaneLength="230"
                                   CompactPaneLength="52"
                                   IsPaneOpen="True"
                                   IsBackButtonVisible="Collapsed"
                                   SelectionChanged="RootNavigationView_SelectionChanged"
                                   SizeChanged="RootNavigationView_SizeChanged"
                                   Background="Transparent"
                                   Foreground="{DynamicResource TextSecondary}">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem x:Name="NavItemGeneral" Content="{DynamicResource Nav.General}" Tag="General" Icon="{ui:SymbolIcon Home24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemApplications" Content="{DynamicResource Nav.Applications}" Tag="Applications" Icon="{ui:SymbolIcon Apps24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemAppearance" Content="{DynamicResource Nav.Appearance}" Tag="Appearance" Icon="{ui:SymbolIcon PaintBrush24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemDisplay" Content="{DynamicResource Nav.Display}" Tag="Display" Icon="{ui:SymbolIcon Desktop24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemGaming" Content="{DynamicResource Nav.Gaming}" Tag="Gaming" Icon="{ui:SymbolIcon Games24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemNotifications" Content="{DynamicResource Nav.Notifications}" Tag="Notifications" Icon="{ui:SymbolIcon Alert24}" Click="NavItem_Click"/>
                        <ui:NavigationViewItem x:Name="NavItemAdvanced" Content="{DynamicResource Nav.Advanced}" Tag="Advanced" Icon="{ui:SymbolIcon Wrench24}" Click="NavItem_Click"/>
                    </ui:NavigationView.MenuItems>
                </ui:NavigationView>

                <!-- Sidebar Footer: Language Dropdown Trigger Button & Popup -->
                <Border Grid.Row="1" x:Name="SidebarFooterBorder"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource DividerColor}"
                        Padding="6,8,6,10"
                        Background="Transparent">
                    <Grid>
                        <Button x:Name="BtnLanguage"
                                Click="BtnLanguage_Click"
                                PreviewKeyDown="BtnLanguage_PreviewKeyDown"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderColor}"
                                Height="38"
                                Padding="8,0"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{DynamicResource Language.Language}"
                                AutomationProperties.HelpText="{DynamicResource Language.ChangeLanguageHelp}"
                                ToolTip="{DynamicResource Language.Language}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlPressedBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Globe24"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Margin="2,0,4,0"/>

                                <TextBlock x:Name="TxtLanguageLabel"
                                           Grid.Column="1"
                                           Text="{DynamicResource Language.Language}"
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,4,0"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel x:Name="PnlLanguageBadge"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Background="{DynamicResource ControlBackground}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtCurrentLangCode"
                                                   Text="EN"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentColor}"/>
                                    </Border>
                                    <ui:SymbolIcon Symbol="ChevronDown24"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Popup x:Name="PopupLanguage"
                               PlacementTarget="{Binding ElementName=BtnLanguage}"
                               Placement="Top"
                               VerticalOffset="-6"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade"
                               KeyDown="PopupLanguage_KeyDown"
                               Opened="PopupLanguage_Opened">
                            <Border Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="6"
                                    MinWidth="190"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="6" Opacity="0.35" Color="#000000"/>
                                </Border.Effect>
                                <StackPanel x:Name="PnlLanguageOptions" KeyboardNavigation.DirectionalNavigation="Cycle">
                                    <Button x:Name="BtnLangEn"
                                            Tag="en-US"
                                            Click="BtnSelectLanguage_Click"
                                            Style="{DynamicResource LanguageItemButtonStyle}"
                                            AutomationProperties.Name="English">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="English" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            <ui:SymbolIcon x:Name="CheckLangEn" Grid.Column="1" Symbol="Checkmark24" FontSize="13" Foreground="{DynamicResource AccentColor}" Visibility="Visible" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="BtnLangEs"
                                            Tag="es-ES"
                                            Click="BtnSelectLanguage_Click"
                                            Style="{DynamicResource LanguageItemButtonStyle}"
                                            AutomationProperties.Name="Español">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Español" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            <ui:SymbolIcon x:Name="CheckLangEs" Grid.Column="1" Symbol="Checkmark24" FontSize="13" Foreground="{DynamicResource AccentColor}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="BtnLangFr"
                                            Tag="fr-FR"
                                            Click="BtnSelectLanguage_Click"
                                            Style="{DynamicResource LanguageItemButtonStyle}"
                                            AutomationProperties.Name="Français">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Français" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            <ui:SymbolIcon x:Name="CheckLangFr" Grid.Column="1" Symbol="Checkmark24" FontSize="13" Foreground="{DynamicResource AccentColor}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>

                                    <Button x:Name="BtnLangTr"
                                            Tag="tr-TR"
                                            Click="BtnSelectLanguage_Click"
                                            Style="{DynamicResource LanguageItemButtonStyle}"
                                            AutomationProperties.Name="Türkçe">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Türkçe" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            <ui:SymbolIcon x:Name="CheckLangTr" Grid.Column="1" Symbol="Checkmark24" FontSize="13" Foreground="{DynamicResource AccentColor}" Visibility="Collapsed" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>

            <!-- Single Authoritative Main Views Container (Expands dynamically to fill entire remaining space) -->
            <Grid Grid.Column="1" x:Name="RootContentGrid" Background="{DynamicResource WindowBackground}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <views:GeneralView x:Name="ViewGeneral" Visibility="Visible" HorizontalAlignment="Stretch"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
