<Window
    x:Class="NotiGlow.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:NotiGlow.UI.Views"
    Title="NotiGlow">

    <Grid Background="Transparent" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <Image x:Name="AppTitleBarIcon" Source="ms-appx:///Assets/NotiGlowLogo.png" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtAppTitle" Text="NotiGlow" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Window Body -->
        <Grid Grid.Row="1">
            <!-- Native WinUI 3 NavigationView -->
            <NavigationView x:Name="RootNavigationView"
                            PaneDisplayMode="Left"
                            OpenPaneLength="236"
                            CompactPaneLength="52"
                            IsPaneOpen="True"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            SelectionChanged="RootNavigationView_SelectionChanged"
                            PaneOpened="RootNavigationView_PaneOpened"
                            PaneClosed="RootNavigationView_PaneClosed"
                            Background="Transparent">
                
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NavItemGeneral" Content="General" Tag="General">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavItemApplications" Content="Applications" Tag="Applications">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE71D;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavItemAppearance" Content="Appearance" Tag="Appearance">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE790;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavItemDisplay" Content="Display" Tag="Display">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7F4;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavItemGaming" Content="Gaming" Tag="Gaming">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE7FC;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavItemNotifications" Content="Notifications" Tag="Notifications">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xEA8F;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NavItemAdvanced" Content="Advanced" Tag="Advanced">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90F;"/>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <!-- Pane Footer: Language Selector with Modern Flyout -->
                <NavigationView.PaneFooter>
                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerColor}" Padding="8,8,8,10">
                        <Button x:Name="BtnLanguage" HorizontalAlignment="Stretch" Padding="8,6" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource BorderColor}">
                            <Button.Flyout>
                                <MenuFlyout Placement="Top">
                                    <MenuFlyoutItem Text="🇬🇧  English" Tag="en-US" Click="LanguageItem_Click"/>
                                    <MenuFlyoutItem Text="🇪🇸  Español" Tag="es-ES" Click="LanguageItem_Click"/>
                                    <MenuFlyoutItem Text="🇫🇷  Français" Tag="fr-FR" Click="LanguageItem_Click"/>
                                    <MenuFlyoutItem Text="🇩🇪  Deutsch" Tag="de-DE" Click="LanguageItem_Click"/>
                                    <MenuFlyoutItem Text="🇹🇷  Türkçe" Tag="tr-TR" Click="LanguageItem_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="TxtLanguageLabel" Text="Language" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" x:Name="PnlLanguageBadge" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Border Background="{ThemeResource ControlBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock x:Name="TxtCurrentLangFlag" Text="🇬🇧" FontSize="11"/>
                                            <TextBlock x:Name="TxtCurrentLangCode" Text="EN" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentColor}"/>
                                        </StackPanel>
                                    </Border>
                                    <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{ThemeResource TextSecondary}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Border>
                </NavigationView.PaneFooter>

                <!-- Content Area -->
                <Grid x:Name="RootContentGrid" Background="Transparent">
                    <Grid.ChildrenTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition IsStaggeringEnabled="False"/>
                        </TransitionCollection>
                    </Grid.ChildrenTransitions>
                    <views:GeneralView x:Name="ViewGeneral" Visibility="Visible" HorizontalAlignment="Stretch"/>

                    <!-- Toast Notification Host Container (Top-Right) -->
                    <StackPanel x:Name="ToastContainer"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="0,24,24,0"
                                Canvas.ZIndex="999"
                                Spacing="8"
                                IsHitTestVisible="False"/>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
