<Window
    x:Class="NotiGlow.UI.Dialogs.UpdateConfirmDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotiGlow Update">
    <Grid Background="{ThemeResource WindowBackground}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="14"
                    Background="#205865F2"
                    BorderBrush="#455865F2"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="#FF5865F2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle"
                           Text="Update Available"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"/>
                <TextBlock Text="NotiGlow"
                           FontSize="12"
                           Foreground="{ThemeResource TextMuted}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="BtnTopClose" Click="BtnCancel_Click" VerticalAlignment="Top" Padding="6,4">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>

        <!-- Version row -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,14">
            <TextBlock x:Name="TxtCurrentVersion" Text="Current: v3.3" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
            <TextBlock Text="→" FontSize="12" Foreground="{ThemeResource TextMuted}"/>
            <TextBlock x:Name="TxtNewVersion" Text="New: v4.0" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentColor}"/>
        </StackPanel>

        <!-- Release Notes -->
        <ScrollViewer Grid.Row="2" MaxHeight="220" Margin="0,0,0,20">
            <TextBlock x:Name="TxtReleaseNotes"
                       Text="Release notes..."
                       FontSize="12"
                       Foreground="{ThemeResource TextSecondary}"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnCancel" Content="Later" HorizontalAlignment="Stretch" Height="38" Click="BtnCancel_Click"/>
            <Button Grid.Column="2" x:Name="BtnInstall" Content="Update Now" HorizontalAlignment="Stretch" Height="38" Click="BtnInstall_Click"/>
        </Grid>
    </Grid>
</Window>
