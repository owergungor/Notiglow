<Window
    x:Class="NotiGlow.UI.Dialogs.ErrorDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotiGlow Error">
    <Grid Background="{ThemeResource WindowBackground}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="40" Height="40"
                    CornerRadius="14"
                    Background="#25E11D48"
                    BorderBrush="#50E11D48"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xEA39;" FontSize="18" Foreground="#FFE11D48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle"
                           Text="Application Error"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"/>
                <TextBlock Text="NotiGlow"
                           FontSize="12"
                           Foreground="{ThemeResource TextMuted}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" x:Name="BtnTopClose" Click="BtnClose_Click" VerticalAlignment="Top" Padding="6,4">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>

        <!-- Message Body -->
        <ScrollViewer Grid.Row="1" MaxHeight="300" Margin="0,0,0,20">
            <StackPanel Spacing="10">
                <TextBlock x:Name="TxtSummary"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtMessage"
                           FontSize="12"
                           Foreground="{ThemeResource TextSecondary}"
                           TextWrapping="Wrap"/>
                <StackPanel x:Name="ExpDetails" Visibility="Collapsed" Spacing="6">
                    <TextBlock x:Name="TxtLogPath" FontSize="11" Foreground="{ThemeResource TextMuted}" TextWrapping="Wrap"/>
                    <Button x:Name="BtnCopyLogPath" Content="Copy Log Path" Click="BtnCopyLogPath_Click" Padding="8,4" FontSize="11"/>
                    <TextBox x:Name="TxtDetails"
                             FontSize="11"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MaxHeight="150"/>
                    <Button x:Name="BtnCopyDetails" Content="Copy Details" Click="BtnCopyDetails_Click" Padding="8,4" FontSize="11"/>
                </StackPanel>
                <TextBox x:Name="TxtTechnicalDetails"
                         FontSize="11"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MaxHeight="150"
                         Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnCopy" Content="Copy Error" Click="BtnCopy_Click"/>
            <Button Grid.Column="2" x:Name="BtnRetry" Content="Retry" Click="BtnRetry_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button Grid.Column="3" x:Name="BtnClose" Content="Close" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
