<Window x:Class="NotiGlow.UI.Dialogs.ErrorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NotiGlow"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="16"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Message -->
                <RowDefinition Height="Auto"/> <!-- Log path card -->
                <RowDefinition Height="Auto"/> <!-- Details expander -->
                <RowDefinition Height="Auto"/> <!-- Bottom action buttons -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Icon, Title, and Close Button -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="#25E11D48"
                        BorderBrush="#50E11D48"
                        BorderThickness="1"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DismissCircle24"
                                   FontSize="20"
                                   Foreground="#FFFF4D6D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                </Border>

                <!-- Title & App Label -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               Text="{DynamicResource Error.StartupTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="NotiGlow"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Top Right Close Button -->
                <Button Grid.Column="2"
                        x:Name="BtnTopClose"
                        Style="{DynamicResource HeroCloseButtonStyle}"
                        Click="BtnClose_Click"
                        VerticalAlignment="Top"
                        ToolTip="{DynamicResource Error.Close}"/>
            </Grid>

            <!-- Row 1: Friendly User Message -->
            <TextBlock Grid.Row="1"
                       x:Name="TxtMessage"
                       Text="{DynamicResource Error.StartupDesc}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,16"/>

            <!-- Row 2: Log Location Card -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBackgroundSecondary}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0"
                                   Symbol="DocumentText24"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Error.LogLocation}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock x:Name="TxtLogPath"
                                   Text="C:\Users\...\AppData\Local\NotiGlow\startup.log"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimary}"
                                   FontFamily="Consolas, Cascadia Mono, monospace"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2"
                               x:Name="BtnCopyLogPath"
                               Appearance="Secondary"
                               Click="BtnCopyLogPath_Click"
                               Padding="10,5"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               ToolTip="{DynamicResource Error.CopyLogPath}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCopyLogLabel" Text="{DynamicResource Error.CopyLogPath}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>

            <!-- Row 3: Technical Details Expander -->
            <Expander Grid.Row="3"
                      x:Name="ExpDetails"
                      Margin="0,0,0,20"
                      IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="{DynamicResource Error.Details}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextSecondary}"/>
                </Expander.Header>
                <Border Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer Grid.Row="0" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtDetails"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextSecondary}"
                                     FontFamily="Consolas, Cascadia Mono, monospace"
                                     FontSize="11"
                                     TextWrapping="NoWrap"
                                     AcceptsReturn="True"/>
                        </ScrollViewer>
                        <ui:Button Grid.Row="1"
                                   x:Name="BtnCopyDetails"
                                   Appearance="Secondary"
                                   Click="BtnCopyDetails_Click"
                                   HorizontalAlignment="Right"
                                   Padding="10,4"
                                   Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Copy24" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCopyDetailsLabel" Text="{DynamicResource Error.CopyDetails}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Border>
            </Expander>

            <!-- Row 4: Bottom Action Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <ui:Button x:Name="BtnRetry"
                           Appearance="Secondary"
                           Content="{DynamicResource Error.Retry}"
                           Click="BtnRetry_Click"
                           Margin="0,0,10,0"
                           Padding="16,7"
                           FontSize="13"
                           Visibility="Collapsed"/>
                <ui:Button x:Name="BtnClose"
                           Appearance="Primary"
                           Content="{DynamicResource Error.Close}"
                           Click="BtnClose_Click"
                           Padding="20,7"
                           FontSize="13"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
