<Window
    x:Class="NotiGlow.UI.Dialogs.ConfirmationDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotiGlow">
    <Grid Background="{ThemeResource WindowBackground}" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header with Icon and Title -->
        <Grid Grid.Row="0" x:Name="HeaderGrid" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon Badge -->
            <Border x:Name="IconBadge"
                    Grid.Column="0"
                    Width="38"
                    Height="38"
                    CornerRadius="14"
                    Background="#203B82F6"
                    BorderBrush="#403B82F6"
                    BorderThickness="1"
                    Margin="0,0,14,0"
                    VerticalAlignment="Center">
                <FontIcon x:Name="HeaderIcon"
                          Glyph="&#xE897;"
                          FontSize="18"
                          Foreground="{ThemeResource AccentColor}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <!-- Title -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle"
                           Text="Confirm Action"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="NotiGlow"
                           FontSize="12"
                           Foreground="{ThemeResource TextMuted}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <Button Grid.Column="2"
                    x:Name="BtnTopClose"
                    Click="BtnCancel_Click"
                    VerticalAlignment="Top"
                    Padding="6,4">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </Grid>

        <!-- Row 1: Message Content -->
        <ScrollViewer Grid.Row="1" MaxHeight="250" Margin="0,0,0,20">
            <TextBlock x:Name="TxtMessage"
                       Text="Are you sure you want to proceed?"
                       FontSize="13"
                       Foreground="{ThemeResource TextSecondary}"
                       TextWrapping="Wrap"/>
        </ScrollViewer>

        <!-- Row 2: Action Buttons -->
        <Grid Grid.Row="2" x:Name="ButtonGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColCancel" Width="*"/>
                <ColumnDefinition x:Name="ColGap" Width="10"/>
                <ColumnDefinition x:Name="ColConfirm" Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="BtnCancel"
                    Content="Cancel"
                    HorizontalAlignment="Stretch"
                    Height="38"
                    Click="BtnCancel_Click"/>

            <Button Grid.Column="2"
                    x:Name="BtnConfirm"
                    Content="Confirm"
                    HorizontalAlignment="Stretch"
                    Height="38"
                    Click="BtnConfirm_Click"/>
        </Grid>
    </Grid>
</Window>
