<UserControl
    x:Class="NotiGlow.UI.Views.GamingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiGlow.UI.Controls"
    Background="Transparent">
    <Grid Background="Transparent">
        <ScrollViewer x:Name="MainScrollViewer"
                      Background="Transparent"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch"
                      IsScrollInertiaEnabled="True"
                      ScrollViewer.VerticalScrollMode="Enabled">
            <StackPanel Margin="32,20,32,48" HorizontalAlignment="Stretch">
                <!-- Header Section with Top-Right Test Game Animation Button -->
                <Grid Margin="0,0,0,20" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtGamingTitle" Text="Gaming Mode" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                        <TextBlock x:Name="TxtGamingSubtitle" Text="Automatic game detection (Steam, Epic, Xbox Game Pass &amp; Store)" Foreground="{ThemeResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="BtnTestAnimation" Click="BtnTestAnimation_Click" VerticalAlignment="Center" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Name="TxtBtnTestGameAnimation" Text="Test Game Animation" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Section 1: Master Gaming Mode Activation -->
                <TextBlock x:Name="TxtSectionGamingMode" Text="Gaming Mode" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" Margin="0,8,0,8"/>
                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                    <Grid MinHeight="64" Padding="16,12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtGamingMode" Text="Gaming Mode" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                                <TextBlock x:Name="TxtGamingModeDesc" Text="Detect running games and apply customized notification behaviors" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <ToggleSwitch Grid.Column="1" x:Name="ToggleGamingMode" OnContent="" OffContent="" HorizontalAlignment="Right" Toggled="ToggleGamingMode_Toggled" VerticalAlignment="Center" AutomationProperties.Name="Gaming Mode"/>
                    </Grid>
                </Border>

                <!-- Section 2: In-Game Behavior Rules -->
                <TextBlock x:Name="TxtBehaviorRules" Text="In-Game Behavior Rules" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" Margin="0,4,0,8"/>
                <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Stretch" Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Stretch">
                        <!-- Row 1: Glow During Games -->
                        <Grid MinHeight="64" Padding="16,12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtGlowDuringGamesTitle" Text="Glow During Games" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtGlowDuringGamesDesc" Text="Allow ambient edge glows to display over fullscreen games" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <ToggleSwitch Grid.Column="1" x:Name="ToggleGlowDuringGames" OnContent="" OffContent="" HorizontalAlignment="Right" Toggled="ToggleGlowDuringGames_Toggled" VerticalAlignment="Center" AutomationProperties.Name="Glow During Games"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                        <!-- Row 2: Reduce Intensity In Games -->
                        <Grid MinHeight="64" Padding="16,12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtReduceIntensityTitle" Text="Dim Intensity in Games" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtReduceIntensityDesc" Text="Automatically dim notifications to prevent gameplay distraction" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <ToggleSwitch Grid.Column="1" x:Name="ToggleReduceIntensityInGames" OnContent="" OffContent="" HorizontalAlignment="Right" Toggled="ToggleReduceIntensityInGames_Toggled" VerticalAlignment="Center" AutomationProperties.Name="Dim Intensity in Games"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                        <!-- Row 3: Reduce Duration In Games -->
                        <Grid MinHeight="64" Padding="16,12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtReduceDurationTitle" Text="Shorten Duration in Games" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtReduceDurationDesc" Text="Dismiss glow faster while in-game" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <ToggleSwitch Grid.Column="1" x:Name="ToggleReduceDurationInGames" OnContent="" OffContent="" HorizontalAlignment="Right" Toggled="ToggleReduceDurationInGames_Toggled" VerticalAlignment="Center" AutomationProperties.Name="Shorten Duration in Games"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                        <!-- Row 4: Only Important In Games -->
                        <Grid MinHeight="64" Padding="16,12" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE734;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtOnlyImportantTitle" Text="High Priority Only" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                                    <TextBlock x:Name="TxtOnlyImportantDesc" Text="Filter out lower priority notifications while gaming" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                            <ToggleSwitch Grid.Column="1" x:Name="ToggleOnlyImportantInGames" OnContent="" OffContent="" HorizontalAlignment="Right" Toggled="ToggleOnlyImportantInGames_Toggled" VerticalAlignment="Center" AutomationProperties.Name="High Priority Only"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 3: Tracked Games & Platform Scan -->
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtTrackedGamesHeader" Text="Detected &amp; Tracked Games" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}"/>
                        <TextBlock x:Name="TxtDetectionStatus" Text="Steam, Epic Games, Xbox App &amp; Microsoft Store supported" Foreground="{ThemeResource TextMuted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BtnScanGames" Click="BtnScanGames_Click" VerticalAlignment="Center" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="Scan Games"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel x:Name="PnlTrackedGames" Spacing="8"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Shared Profile / Game Glow Override Editor Drawer Overlay (Deferred via x:Load) -->
        <controls:ProfileEditorControl x:Name="PnlEditGameOverride"
                                       x:Load="False"
                                       Margin="32,20,32,24"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Stretch"
                                       HorizontalAlignment="Stretch"
                                       SaveRequested="PnlEditGameOverride_SaveRequested"
                                       CancelRequested="PnlEditGameOverride_CancelRequested"/>
    </Grid>
</UserControl>