<UserControl x:Class="NotiGlow.UI.Views.GamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="800">
    <Grid>
        <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <!-- Header Section with Top-Right Test Game Animation Button -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Gaming.Title}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Gaming.Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ui:Button Grid.Column="1" x:Name="BtnTestAnimation" Appearance="Primary" Click="BtnTestAnimation_Click" VerticalAlignment="Center" ToolTip="{DynamicResource Gaming.TestGameAnimationToolTip}" Foreground="{DynamicResource TextPrimary}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtBtnTestGameAnimation" Text="{DynamicResource Gaming.TestGameAnimation}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <!-- Master Gaming Mode Toggle -->
                <ui:CardControl Padding="18" Margin="0,0,0,16" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Games24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Gaming.Mode}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Gaming.ModeDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ToggleGamingMode" Click="ToggleGamingMode_Click" VerticalAlignment="Center"/>
                </ui:CardControl>

                <TextBlock Text="{DynamicResource Gaming.BehaviorRules}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,8,0,12"/>

                <!-- Glow During Games -->
                <ui:CardControl x:Name="CardGlowDuringGames" Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <ui:CardControl.Header>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGlowDuringGamesTitle" Text="{DynamicResource Gaming.GlowDuringGames}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TxtGlowDuringGamesDesc" Text="{DynamicResource Gaming.GlowDuringGamesDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ToggleGlowDuringGames" Click="ToggleGlowDuringGames_Click" VerticalAlignment="Center"/>
                </ui:CardControl>

                <!-- Reduce Intensity In Games -->
                <ui:CardControl x:Name="CardReduceIntensityInGames" Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <ui:CardControl.Header>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtReduceIntensityTitle" Text="{DynamicResource Gaming.ReduceIntensity}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TxtReduceIntensityDesc" Text="{DynamicResource Gaming.ReduceIntensityDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ToggleReduceIntensityInGames" Click="ToggleReduceIntensityInGames_Click" VerticalAlignment="Center"/>
                </ui:CardControl>

                <!-- Reduce Duration In Games -->
                <ui:CardControl x:Name="CardReduceDurationInGames" Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <ui:CardControl.Header>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtReduceDurationTitle" Text="{DynamicResource Gaming.ReduceDuration}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TxtReduceDurationDesc" Text="{DynamicResource Gaming.ReduceDurationDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ToggleReduceDurationInGames" Click="ToggleReduceDurationInGames_Click" VerticalAlignment="Center"/>
                </ui:CardControl>

                <!-- Only Important Notifications -->
                <ui:CardControl x:Name="CardOnlyImportantInGames" Padding="18" Margin="0,0,0,20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <ui:CardControl.Header>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtOnlyImportantTitle" Text="{DynamicResource Gaming.OnlyImportant}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TxtOnlyImportantDesc" Text="{DynamicResource Gaming.OnlyImportantDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <ui:ToggleSwitch x:Name="ToggleOnlyImportantInGames" Click="ToggleOnlyImportantInGames_Click" VerticalAlignment="Center"/>
                </ui:CardControl>

                <!-- Common Gaming Glow Settings Section -->
                <TextBlock Text="{DynamicResource Gaming.CommonSettingsTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,4"/>
                <TextBlock Text="{DynamicResource Gaming.CommonSettingsDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

                <!-- Common Duration Card -->
                <ui:CardControl Padding="16" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Gaming.CommonDuration}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Gaming.ReduceDurationDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCommonGamingDurationVal" Text="3000 ms" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <Slider x:Name="SldCommonGamingDuration" Minimum="1000" Maximum="10000" Value="3000" SmallChange="100" LargeChange="500" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="SldCommonGamingDuration_ValueChanged"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Common Glow Intensity Card -->
                <ui:CardControl Padding="16" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Gaming.CommonIntensity}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Gaming.ReduceIntensityDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCommonGamingIntensityVal" Text="80%" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <Slider x:Name="SldCommonGamingIntensity" Minimum="10" Maximum="100" Value="80" SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldCommonGamingIntensity_ValueChanged"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Common Glow Blur Size Card -->
                <ui:CardControl Padding="16" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Gaming.CommonBlurSize}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Gaming.GlowDuringGamesDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCommonGamingGlowSizeVal" Text="32 px" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <Slider x:Name="SldCommonGamingGlowSize" Minimum="0" Maximum="256" Value="32" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldCommonGamingGlowSize_ValueChanged"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Common Glow Corner Rounding Card -->
                <ui:CardControl Padding="16" Margin="0,0,0,24" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Appearance.CornerRounding}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{DynamicResource Appearance.CornerRoundingDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtCommonGamingCornerRadiusVal" Text="0 px" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <Slider x:Name="SldCommonGamingCornerRadius" Minimum="0" Maximum="48" Value="0" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldCommonGamingCornerRadius_ValueChanged"/>
                    </StackPanel>
                </ui:CardControl>

                <!-- Tracked Games Section Header & Controls -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Gaming.TrackedGames}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtDetectionStatus" Text="{DynamicResource Gaming.DetectionSupport}" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Segmented View Switcher: List vs Grid (Matching Applications page) -->
                        <Border Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="2"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RbGameListView"
                                             GroupName="TrackedGameViewModeGroup"
                                             Style="{DynamicResource SegmentedThemeRadioButtonStyle}"
                                             IsChecked="True"
                                             Click="RbGameViewMode_Click"
                                             ToolTip="{DynamicResource Gaming.ListView}"
                                             AutomationProperties.Name="{DynamicResource Gaming.ListView}"
                                             Height="28" Width="36" Padding="0">
                                    <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </RadioButton>
                                <RadioButton x:Name="RbGameGridView"
                                             GroupName="TrackedGameViewModeGroup"
                                             Style="{DynamicResource SegmentedThemeRadioButtonStyle}"
                                             Click="RbGameViewMode_Click"
                                             ToolTip="{DynamicResource Gaming.GridView}"
                                             AutomationProperties.Name="{DynamicResource Gaming.GridView}"
                                             Height="28" Width="36" Padding="0">
                                    <ui:SymbolIcon Symbol="Grid24" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <ui:Button x:Name="BtnScanGames" Appearance="Secondary" Click="BtnScanGames_Click" VerticalAlignment="Center" ToolTip="{DynamicResource Gaming.ScanLaunchersToolTip}" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Gaming.ScanLaunchers}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnAddGamePickerTop" Appearance="Primary" Click="BtnAddGamePicker_Click" VerticalAlignment="Center" ToolTip="{DynamicResource Gaming.AddGameToolTip}" Foreground="{DynamicResource TextPrimary}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Gaming.AddGame}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Tracked Games Main Area -->
                <Grid>
                    <!-- List View Container -->
                    <StackPanel x:Name="PnlGameList" HorizontalAlignment="Stretch"/>

                    <!-- Grid View Container -->
                    <WrapPanel x:Name="PnlGameGrid" HorizontalAlignment="Stretch" Visibility="Collapsed"/>

                    <!-- Empty State Container -->
                    <Border x:Name="PnlEmptyGames"
                            Background="{DynamicResource CardBackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="32,24"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Games24" FontSize="36" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource Gaming.NoTrackedGames}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Edit Per-Game Glow Overrides Drawer Overlay -->
        <Border x:Name="PnlEditGameOverride"
                Background="{DynamicResource CardBackground}"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{DynamicResource BorderColor}"
                Padding="24"
                Margin="24"
                Visibility="Collapsed"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                    <!-- Drawer Header -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEditGameTitle"
                                       Text="{DynamicResource Gaming.PerGameOverrides}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TxtEditGameIdentifier"
                                       Text="game.exe"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <ui:Button x:Name="BtnCloseGameEditor"
                                   Appearance="Transparent"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Click="BtnCloseGameEditor_Click"
                                   Padding="6">
                            <ui:SymbolIcon Symbol="Dismiss24" Foreground="{DynamicResource TextSecondary}"/>
                        </ui:Button>
                    </Grid>

                    <!-- Duration Override Section -->
                    <Border Background="{DynamicResource CardBackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkOverrideDuration"
                                              Content="{DynamicResource Gaming.GlowDuration}"
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Click="ChkOverride_Click"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtEditDurationVal"
                                           Text="3000 ms"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <Slider x:Name="SldGameDuration"
                                    Minimum="500"
                                    Maximum="15000"
                                    Value="3000"
                                    SmallChange="500"
                                    LargeChange="1000"
                                    TickFrequency="500"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SldGameDuration_ValueChanged"/>
                            <TextBlock x:Name="TxtDurationInheritHint"
                                       Text="{DynamicResource Gaming.InheritGlobal}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Intensity Override Section -->
                    <Border Background="{DynamicResource CardBackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkOverrideIntensity"
                                              Content="{DynamicResource Gaming.GlowIntensity}"
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Click="ChkOverride_Click"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtEditIntensityVal"
                                           Text="80%"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <Slider x:Name="SldGameIntensity"
                                    Minimum="10"
                                    Maximum="100"
                                    Value="80"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SldGameIntensity_ValueChanged"/>
                            <TextBlock x:Name="TxtIntensityInheritHint"
                                       Text="{DynamicResource Gaming.InheritGlobal}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Blur Size Override Section -->
                    <Border Background="{DynamicResource CardBackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkOverrideGlowSize"
                                              Content="{DynamicResource Gaming.GlowBlurSize}"
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Click="ChkOverride_Click"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtEditGlowSizeVal"
                                           Text="32 px"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <Slider x:Name="SldGameGlowSize"
                                    Minimum="0"
                                    Maximum="256"
                                    Value="32"
                                    SmallChange="1"
                                    LargeChange="5"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SldGameGlowSize_ValueChanged"/>
                            <TextBlock x:Name="TxtGlowSizeInheritHint"
                                       Text="{DynamicResource Gaming.InheritGlobal}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Corner Rounding Override Section -->
                    <Border Background="{DynamicResource CardBackgroundSecondary}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,14"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkOverrideCornerRadius"
                                              Content="{DynamicResource Appearance.CornerRounding}"
                                              FontWeight="SemiBold"
                                              FontSize="13"
                                              Click="ChkOverride_Click"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtEditCornerRadiusVal"
                                           Text="0 px"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <Slider x:Name="SldGameCornerRadius"
                                    Minimum="0"
                                    Maximum="48"
                                    Value="0"
                                    SmallChange="1"
                                    LargeChange="2"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SldGameCornerRadius_ValueChanged"/>
                            <TextBlock x:Name="TxtCornerRadiusInheritHint"
                                       Text="{DynamicResource Gaming.InheritGlobal}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <ui:Button x:Name="BtnResetGameOverrides"
                                   Content="{DynamicResource Gaming.ResetToDefault}"
                                   Appearance="Secondary"
                                   Click="BtnResetGameOverrides_Click"
                                   Margin="0,0,10,0"/>
                        <ui:Button x:Name="BtnSaveGameOverrides"
                                   Content="{DynamicResource Common.Save}"
                                   Appearance="Primary"
                                   Click="BtnSaveGameOverrides_Click"
                                   Margin="0,0,10,0"/>
                        <ui:Button Content="{DynamicResource Common.Cancel}"
                                   Appearance="Secondary"
                                   Click="BtnCloseGameEditor_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
