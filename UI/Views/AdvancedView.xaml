<UserControl x:Class="NotiGlow.UI.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header Section with Top-Right Test Animation Button -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Advanced.Title}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{DynamicResource Advanced.Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <ui:Button Grid.Column="1" x:Name="BtnTestAnimation" Appearance="Primary" Click="BtnTestAnimation_Click" VerticalAlignment="Center" ToolTip="{DynamicResource Common.TestAnimationToolTip}" Foreground="{DynamicResource TextPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Common.TestAnimation}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Section 1: Auto Update -->
            <TextBlock Text="{DynamicResource Advanced.AutoUpdate}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <!-- Automatic Updates -->
            <ui:CardControl Padding="18" Margin="0,0,0,12" HorizontalAlignment="Stretch" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Advanced.AutomaticUpdates}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="TxtUpdateStatus" Text="Current Version: v2.0 • Automatic update checking via GitHub Releases" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="PbUpdateProgress" Height="4" Margin="0,6,0,0" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource AccentColor}"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnCheckUpdates" Content="{DynamicResource Advanced.CheckForUpdates}" Appearance="Secondary" Click="BtnCheckUpdates_Click" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource TextPrimary}"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:ToggleSwitch x:Name="ToggleAutoUpdates" IsChecked="True" Click="ToggleAutoUpdates_Click" VerticalAlignment="Center" ToolTip="{DynamicResource Advanced.AutoCheckUpdatesToolTip}"/>
                </StackPanel>
            </ui:CardControl>

            <!-- Check Frequency Dropdown -->
            <ui:CardControl Padding="18" Margin="0,0,0,24" HorizontalAlignment="Stretch" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Advanced.CheckFrequency}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Advanced.CheckFrequencyDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="CmbUpdateFrequency"
                          Style="{DynamicResource AppleSelectComboBoxStyle}"
                          Width="180"
                          VerticalAlignment="Center"
                          SelectionChanged="CmbUpdateFrequency_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Advanced.FreqStartup}" Tag="OnStartup"/>
                    <ComboBoxItem Content="{DynamicResource Advanced.FreqDaily}" Tag="Daily"/>
                    <ComboBoxItem Content="{DynamicResource Advanced.FreqWeekly}" Tag="Weekly"/>
                    <ComboBoxItem Content="{DynamicResource Advanced.FreqMonthly}" Tag="Monthly"/>
                </ComboBox>
            </ui:CardControl>

            <!-- Section 2: Accessibility -->
            <TextBlock Text="{DynamicResource Advanced.Accessibility}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12"/>

            <!-- OLED Mode -->
            <ui:CardControl Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Desktop24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Advanced.OledMode}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="{DynamicResource Advanced.OledModeDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleOledMode" Click="ToggleOledMode_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Reduce Motion -->
            <ui:CardControl Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Advanced.ReduceMotion}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Advanced.ReduceMotionDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleReduceMotion" Click="ToggleReduceMotion_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Reduce Glow -->
            <ui:CardControl Padding="18" Margin="0,0,0,24" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Advanced.ReduceGlow}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Advanced.ReduceGlowDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleReduceGlow" Click="ToggleReduceGlow_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Section 2: Backup & Restore -->
            <TextBlock Text="{DynamicResource Advanced.BackupRestore}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12"/>

            <!-- Settings Import / Export / Reset -->
            <ui:CardControl Padding="18" Margin="0,0,0,24" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Advanced.ConfigManagement}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Advanced.ConfigManagementDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnExport" Content="{DynamicResource Advanced.ExportSettings}" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Primary" Click="BtnExport_Click" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}"/>
                    <ui:Button x:Name="BtnImport" Content="{DynamicResource Advanced.ImportSettings}" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Secondary" Click="BtnImport_Click" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}"/>
                    <ui:Button x:Name="BtnReset" Content="{DynamicResource Advanced.FactoryReset}" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="BtnReset_Click"/>
                </StackPanel>
            </ui:CardControl>

            <!-- Section 3: Diagnostics -->
            <TextBlock Text="{DynamicResource Advanced.Diagnostics}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12"/>

            <!-- Debug Logging Toggle -->
            <ui:CardControl Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Advanced.DebugLogging}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Advanced.DebugLoggingDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleDebugLogging" Click="ToggleDebugLogging_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Notification Identity Debug Toggle -->
            <ui:CardControl Padding="18" Margin="0,0,0,24" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Advanced.IdentityDebug}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="{DynamicResource Advanced.IdentityDebugDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleIdentityDebug" Click="ToggleIdentityDebug_Click" VerticalAlignment="Center"/>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
