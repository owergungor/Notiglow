<UserControl x:Class="NotiGlow.UI.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header Section with Top-Right Test Animation Button -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Advanced" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="Performance tuning, OLED burn-in protection, diagnostic tools, and backup options." Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <ui:Button Grid.Column="1" x:Name="BtnTestAnimation" Appearance="Primary" Click="BtnTestAnimation_Click" VerticalAlignment="Center" ToolTip="Test notification glow animation" Foreground="{DynamicResource TextPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Test Animation" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Section 1: Accessibility -->
            <TextBlock Text="Accessibility" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <!-- OLED Mode -->
            <ui:CardControl Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Desktop24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OLED Friendly Mode" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Reduces static bright elements to help minimize OLED image retention." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleOledMode" Click="ToggleOledMode_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Reduce Motion -->
            <ui:CardControl Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reduce Motion" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Reduces animated movement throughout notification effects." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleReduceMotion" Click="ToggleReduceMotion_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Reduce Glow -->
            <ui:CardControl Padding="18" Margin="0,0,0,24" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Reduce Glow" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Reduces glow brightness across notification effects." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleReduceGlow" Click="ToggleReduceGlow_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Section 2: Backup & Restore -->
            <TextBlock Text="Backup &amp; Restore" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12"/>

            <!-- Settings Import / Export / Reset -->
            <ui:CardControl Padding="18" Margin="0,0,0,24" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Configuration Management" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Export profiles to JSON file, import backups, or restore factory defaults." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnExport" Content="Export Settings" Icon="{ui:SymbolIcon ArrowUpload24}" Appearance="Primary" Click="BtnExport_Click" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}"/>
                    <ui:Button x:Name="BtnImport" Content="Import Settings" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Secondary" Click="BtnImport_Click" Margin="0,0,8,0" Foreground="{DynamicResource TextPrimary}"/>
                    <ui:Button x:Name="BtnReset" Content="Factory Reset" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="BtnReset_Click"/>
                </StackPanel>
            </ui:CardControl>

            <!-- Section 3: Diagnostics -->
            <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12"/>

            <!-- Debug Logging Toggle -->
            <ui:CardControl Padding="18" Margin="0,0,0,12" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Debug Logging" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Records diagnostic information to help troubleshoot application issues." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleDebugLogging" Click="ToggleDebugLogging_Click" VerticalAlignment="Center"/>
            </ui:CardControl>

            <!-- Notification Identity Debug Toggle -->
            <ui:CardControl Padding="18" Margin="0,0,0,24" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}" HorizontalAlignment="Stretch">
                <ui:CardControl.Header>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Notification Identity Debug" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Shows additional information used to identify notification sources." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="ToggleIdentityDebug" Click="ToggleIdentityDebug_Click" VerticalAlignment="Center"/>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
