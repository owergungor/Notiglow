<UserControl
    x:Class="NotiGlow.UI.Views.ApplicationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiGlow.UI.Controls"
    Background="Transparent">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Controls (Responsive Adaptive Layout) -->
        <Grid Grid.Row="0" x:Name="HeaderGrid" Margin="32,20,32,16" SizeChanged="HeaderGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" x:Name="HeaderCol0"/>
                <ColumnDefinition Width="Auto" x:Name="HeaderCol1"/>
            </Grid.ColumnDefinitions>

            <!-- Page Title & Subtitle -->
            <StackPanel x:Name="HeaderTitlePanel"
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="0,0,16,6">
                <TextBlock x:Name="TxtAppTitle"
                           Text="Tracked Applications"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtAppSubtitle"
                           Text="Configure custom colors and glow animations for each app"
                           Foreground="{ThemeResource TextSecondary}"
                           FontSize="13"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Toolbar Controls (List-Only Windows 11 Settings Layout) -->
            <StackPanel x:Name="HeaderToolbarPanel"
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                <!-- A-Z sort dropdown -->
                <ComboBox x:Name="CmbApplicationSort"
                          Width="86"
                          Height="32"
                          VerticalAlignment="Center"
                          SelectionChanged="CmbApplicationSort_SelectionChanged">
                    <ComboBoxItem Tag="Alphabetical" Content="A-Z (Name)" IsSelected="True"/>
                    <ComboBoxItem Tag="RecentlyAdded" Content="Recently Added"/>
                </ComboBox>

                <!-- Scan Button -->
                <Button x:Name="BtnScanApplications"
                        Click="BtnScanApplications_Click"
                        Height="32"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock x:Name="TxtBtnScan" Text="Scan"/>
                    </StackPanel>
                </Button>

                <!-- Add App Button -->
                <Button x:Name="BtnAddApplication"
                        Click="BtnAddApplication_Click"
                        Height="32"
                        VerticalAlignment="Center"
                        Style="{StaticResource HeroPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="TxtBtnAdd" Text="Add App" Foreground="#FFFFFF"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area: App Profile List & Shared Profile Editor Drawer -->
        <Grid Grid.Row="1">
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition IsStaggeringEnabled="False"/>
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <!-- App Profile List ScrollViewer (Scrollbar flush right, UI Virtualized via ItemsRepeater) -->
            <ScrollViewer x:Name="ListScrollViewer"
                          Background="Transparent"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch"
                          IsScrollInertiaEnabled="True"
                          ScrollViewer.VerticalScrollMode="Enabled"
                          Padding="32,0,32,24"
                          Margin="0">
                <ItemsRepeater x:Name="PnlAppCards"
                               HorizontalAlignment="Stretch"
                               ElementPrepared="PnlAppCards_ElementPrepared"
                               ElementClearing="PnlAppCards_ElementClearing">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <controls:AppProfileCard/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Reusable Edit / Add Profile Drawer Overlay (Deferred via x:Load) -->
            <controls:ProfileEditorControl x:Name="PnlEditProfile"
                                           x:Load="False"
                                           Margin="32,0,32,24"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Stretch"
                                           HorizontalAlignment="Stretch"
                                           SaveRequested="PnlEditProfile_SaveRequested"
                                           CancelRequested="PnlEditProfile_CancelRequested"/>
        </Grid>
    </Grid>
</UserControl>
