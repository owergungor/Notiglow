<UserControl x:Class="NotiGlow.UI.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:NotiGlow.UI.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Controls -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Applications.Title}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{DynamicResource Applications.Subtitle}" Foreground="{DynamicResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="CmbApplicationSort" Style="{DynamicResource ColorThemeComboBoxStyle}" Width="92" MinHeight="36" Margin="0,0,12,0" SelectionChanged="CmbApplicationSort_SelectionChanged" DropDownOpened="CmbApplicationSort_DropDownOpened" DropDownClosed="CmbApplicationSort_DropDownClosed" ToolTip="{DynamicResource Applications.SortToolTip}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="MinWidth" Value="190"/>
                            <Setter Property="MinHeight" Value="34"/>
                            <Setter Property="Padding" Value="10,4"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Margin="1"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardBackgroundSecondary}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBoxItem Tag="Alphabetical" IsSelected="True" Content="{DynamicResource Applications.SortAlphabeticalAscendingShort}"/>
                    <ComboBoxItem Tag="RecentlyAdded" Content="{DynamicResource Applications.SortRecentlyAddedShort}"/>
                </ComboBox>
                <!-- Hero UI Segmented View Switcher: List vs Grid -->
                <Border Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbListView"
                                     GroupName="AppViewModeGroup"
                                     Style="{DynamicResource SegmentedThemeRadioButtonStyle}"
                                     IsChecked="True"
                                     Click="RbViewMode_Click"
                                     ToolTip="{DynamicResource Applications.ListView}"
                                     AutomationProperties.Name="{DynamicResource Applications.ListView}"
                                     Height="28"
                                     Width="36"
                                     Padding="0">
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </RadioButton>
                        <RadioButton x:Name="RbGridView"
                                     GroupName="AppViewModeGroup"
                                     Style="{DynamicResource SegmentedThemeRadioButtonStyle}"
                                     Click="RbViewMode_Click"
                                     ToolTip="{DynamicResource Applications.GridView}"
                                     AutomationProperties.Name="{DynamicResource Applications.GridView}"
                                     Height="28"
                                     Width="36"
                                     Padding="0">
                            <ui:SymbolIcon Symbol="Grid24" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <ui:Button x:Name="BtnScanApplications" Appearance="Secondary" Click="BtnScanApplications_Click" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{DynamicResource Applications.ScanAppsToolTip}" Foreground="{DynamicResource TextPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Applications.ScanShort}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <ui:Button x:Name="BtnAddApplication" Appearance="Secondary" Click="BtnAddApplication_Click" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{DynamicResource Applications.AddApplicationToolTip}" Foreground="{DynamicResource TextPrimary}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Applications.AddShort}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

            </StackPanel>
        </Grid>

        <!-- Main Content Area: App List / Grid vs Edit Drawer Overlay -->
        <Grid Grid.Row="2">
            <!-- App Profile List ScrollViewer -->
            <ScrollViewer x:Name="ListScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Normal Tracked Apps -->
                    <StackPanel x:Name="PnlAppCards" HorizontalAlignment="Stretch"/>

                    <!-- Gaming Apps Section (Bottom of Tracked Apps) -->
                    <Border x:Name="SectionGamingHeader" Margin="0,18,0,10" Padding="0,8,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="{DynamicResource AccentColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Gaming.GamingAppsSectionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Gaming.GamingAppsSectionDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="26,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="PnlGamingCards" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>

            <!-- App Profile Grid ScrollViewer -->
            <ScrollViewer x:Name="GridScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Normal Tracked Apps Grid -->
                    <WrapPanel x:Name="PnlAppGridCards" HorizontalAlignment="Stretch"/>

                    <!-- Gaming Apps Grid Section (Bottom of Tracked Apps) -->
                    <Border x:Name="SectionGamingGridHeader" Margin="0,18,0,10" Padding="0,8,0,4">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Games24" FontSize="18" Foreground="{DynamicResource AccentColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Gaming.GamingAppsSectionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Gaming.GamingAppsSectionDesc}" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="26,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel x:Name="PnlGamingGridCards" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Edit / Add Profile Dialog Drawer Overlay -->
            <Border x:Name="PnlEditProfile" Background="{DynamicResource CardBackground}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" Padding="0" Visibility="Collapsed" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,16,20" Margin="0,2,4,2">
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock x:Name="TxtEditorTitle" Text="{DynamicResource Applications.EditProfile}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <ui:Button x:Name="BtnCloseEditor" HorizontalAlignment="Right" Appearance="Secondary" Click="BtnCloseEditor_Click" ToolTip="{DynamicResource Common.Cancel}" Width="36" Height="36" Padding="0">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ui:Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Application Name Input -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Applications.AppName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ui:TextBox x:Name="TxtEditAppName" MinHeight="36" Padding="10,6" PlaceholderText="{DynamicResource Applications.AppNamePlaceholder}"/>
                                </StackPanel>

                                <!-- Executable / App ID Input & Browse Button -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Applications.ExecutableOrAppId}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="TxtEditAppId" MinHeight="36" Padding="10,6" PlaceholderText="{DynamicResource Applications.AppIdPlaceholder}" Grid.Column="0"/>
                                        <ui:Button x:Name="BtnBrowseAppId" Grid.Column="1" Margin="8,0,0,0" Appearance="Secondary" Click="BtnBrowseAppId_Click" ToolTip="{DynamicResource Applications.BrowseToolTip}" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="FolderOpen24" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource Common.Browse}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </ui:Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Animation Style (Compact Apple select combobox style: 36px) -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Applications.AnimationEffect}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbEditStyle" Style="{DynamicResource AppleSelectComboBoxStyle}" MinHeight="36" Height="36" SelectionChanged="EditControl_Changed" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{DynamicResource Style.PulseDetailed}" Tag="Pulse"/>
                                        <ComboBoxItem Content="{DynamicResource Style.SweepDetailed}" Tag="Sweep"/>
                                        <ComboBoxItem Content="{DynamicResource Style.CometDetailed}" Tag="Comet"/>
                                        <ComboBoxItem Content="{DynamicResource Style.RippleDetailed}" Tag="Ripple"/>
                                        <ComboBoxItem Content="{DynamicResource Style.AmbientDetailed}" Tag="Ambient"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Category Selector -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Applications.Category}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbEditCategory" Style="{DynamicResource AppleSelectComboBoxStyle}" MinHeight="36" Height="36" SelectionChanged="EditControl_Changed" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{DynamicResource Applications.CategoryGeneral}" Tag="General"/>
                                        <ComboBoxItem Content="{DynamicResource Applications.CategoryGaming}" Tag="Gaming"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Priority Selector -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{DynamicResource Applications.Priority}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbEditPriority" Style="{DynamicResource AppleSelectComboBoxStyle}" MinHeight="36" Height="36" SelectionChanged="EditControl_Changed" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="{DynamicResource Applications.PriorityLow}" Tag="Low"/>
                                        <ComboBoxItem Content="{DynamicResource Applications.PriorityNormal}" Tag="Normal"/>
                                        <ComboBoxItem Content="{DynamicResource Applications.PriorityHigh}" Tag="High"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Duration Slider -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Applications.Duration}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtDurationVal" Text="4 s" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                    <Slider x:Name="SldDuration" Minimum="500" Maximum="15000" Value="4000" SmallChange="500" LargeChange="1000" TickFrequency="500" IsSnapToTickEnabled="True" ValueChanged="SldDuration_ValueChanged"/>
                                </StackPanel>

                                <!-- Intensity Slider -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Applications.Intensity}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtIntensityVal" Text="80%" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                    <Slider x:Name="SldIntensity" Minimum="10" Maximum="100" Value="80" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldIntensity_ValueChanged"/>
                                </StackPanel>

                                <!-- Glow Size -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Applications.GlowSize}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtGlowSizeVal" Text="32 px" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                    <Slider x:Name="SldGlowSize" Minimum="0" Maximum="256" Value="32" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldGlowSize_ValueChanged"/>
                                </StackPanel>

                                <!-- Corner Rounding -->
                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Appearance.CornerRounding}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtAppCornerVal" Text="0 px" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}"/>
                                    </Grid>
                                    <Slider x:Name="SldAppCorner" Minimum="0" Maximum="48" Value="0" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldAppCorner_ValueChanged"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <!-- Color Picker -->
                                <controls:ColorPickerControl x:Name="EditColorPicker" ColorChanged="EditColorPicker_ColorChanged" Margin="0,0,0,16"/>

                                <!-- Live Preview Box -->
                                <TextBlock Text="{DynamicResource Applications.LivePreview}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <controls:EdgePreviewControl x:Name="EditEdgePreview" Height="160" HorizontalAlignment="Stretch"/>

                                <!-- Save / Cancel Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                                    <ui:Button x:Name="BtnSaveProfile" Content="{DynamicResource Applications.SaveProfile}" Appearance="Primary" Click="BtnSaveProfile_Click" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <ui:Button Content="{DynamicResource Common.Cancel}" Appearance="Secondary" Click="BtnCloseEditor_Click" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
