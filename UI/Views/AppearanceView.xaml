<UserControl
    x:Class="NotiGlow.UI.Views.AppearanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NotiGlow.UI.Controls"
    Background="Transparent">
    <ScrollViewer x:Name="RootScrollViewer"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  IsScrollInertiaEnabled="True"
                  ScrollViewer.VerticalScrollMode="Enabled">
        <StackPanel Margin="32,20,32,48">
            <!-- Header Section with Top-Right Test Animation Button -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAppearanceTitle" Text="Appearance &amp; Glow Effects" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                    <TextBlock x:Name="TxtAppearanceSubtitle" Text="Customize default animation style, intensity, and edge parameters" Foreground="{ThemeResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnTestAnimation" Click="BtnTestAnimation_Click" VerticalAlignment="Center" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource TextPrimary}"/>
                        <TextBlock x:Name="TxtBtnTestAnimation" Text="Test Animation" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Group 1: Animation Style & Timing -->
            <TextBlock x:Name="TxtSectionAnimation" Text="Animation Style &amp; Timing" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" Margin="0,8,0,8"/>
            <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Row 1: Default Style -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtDefaultStyle" Text="Default Style" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Name="TxtDefaultStyleDesc" Text="Default animation effect applied to new profiles" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  x:Name="CmbDefaultStyle"
                                  Width="180"
                                  VerticalAlignment="Center"
                                  SelectionChanged="Default_Changed">
                            <ComboBoxItem Tag="Pulse" Content="Pulse (Heartbeat)" IsSelected="True"/>
                            <ComboBoxItem Tag="Sweep" Content="Sweep (Screen Beam)"/>
                            <ComboBoxItem Tag="Comet" Content="Comet (Travelling)"/>
                            <ComboBoxItem Tag="Ripple" Content="Ripple (Shockwave)"/>
                            <ComboBoxItem Tag="Ambient" Content="Ambient (Soft Glow)"/>
                        </ComboBox>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                    <!-- Row 2: Duration Slider -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE916;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtDuration" Text="Default Duration" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock Text="How long the ambient glow plays before fading out" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TxtDurationVal" Text="4 s" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                            <Slider x:Name="SldDefaultDuration" Minimum="500" Maximum="15000" Value="4000" StepFrequency="500" ValueChanged="Default_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                    <!-- Row 3: Intensity Slider -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE706;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtIntensity" Text="Default Intensity" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock Text="Brightness and peak opacity of the glow illumination" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TxtIntensityVal" Text="80%" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                            <Slider x:Name="SldDefaultIntensity" Minimum="10" Maximum="100" Value="80" StepFrequency="1" ValueChanged="Default_Changed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 2: Geometry & Border -->
            <TextBlock x:Name="TxtSectionGeometry" Text="Geometry &amp; Border" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" Margin="0,4,0,8"/>
            <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Row 1: Thickness Slider -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtThickness" Text="Border Thickness" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock Text="Width of the solid inner edge stroke" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TxtThicknessVal" Text="4 px" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                            <Slider x:Name="SldDefaultThickness" Minimum="1" Maximum="32" Value="4" StepFrequency="1" ValueChanged="Default_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                    <!-- Row 2: Glow Bloom Size Slider -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE735;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtGlowSize" Text="Glow Bloom Size" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock Text="Diffusion spread of outer ambient light" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TxtGlowSizeVal" Text="32 px" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                            <Slider x:Name="SldDefaultGlowSize" Minimum="0" Maximum="256" Value="32" StepFrequency="1" ValueChanged="Default_Changed"/>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                    <!-- Row 3: Screen Corner Rounding Slider -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE743;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtCornerRounding" Text="Screen Corner Rounding" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock Text="Corner curve radius to match rounded display hardware" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="TxtCornerRoundingVal" Text="0 px" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextSecondary}"/>
                            <Slider x:Name="SldCornerRounding" Minimum="0" Maximum="48" Value="0" StepFrequency="1" ValueChanged="Default_Changed"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 3: Color Palette & Live Preview -->
            <TextBlock x:Name="TxtSectionColorPreview" Text="Accent Color &amp; Live Preview" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" Margin="0,4,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Color Picker Card -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <controls:ColorPickerControl x:Name="DefaultColorPicker" ColorChanged="DefaultColorPicker_ColorChanged"/>
                </Border>

                <!-- Right: Live Preview Card -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE7B5;" FontSize="16" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Name="TxtLivePreview" Text="Live Preview" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                        </StackPanel>
                        <controls:EdgePreviewControl x:Name="AppearancePreview" Height="220" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>