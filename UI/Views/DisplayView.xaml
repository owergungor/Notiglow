<UserControl
    x:Class="NotiGlow.UI.Views.DisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <ScrollViewer x:Name="RootScrollViewer"
                  Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  IsScrollInertiaEnabled="True"
                  ScrollViewer.VerticalScrollMode="Enabled">
        <StackPanel Margin="32,20,32,48">
            <!-- Header Section with Top-Right Test Animation Button -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDisplayTitle" Text="Display &amp; Monitors" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                    <TextBlock x:Name="TxtDisplaySubtitle" Text="Configure screen target preferences for ambient notification glows" Foreground="{ThemeResource TextSecondary}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnTestAnimation" Click="BtnTestAnimation_Click" VerticalAlignment="Center" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource TextPrimary}"/>
                        <TextBlock x:Name="TxtBtnTestAnimation" Text="Test Animation" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Mode Selection Group -->
            <TextBlock x:Name="TxtSectionTargetDisplay" Text="Target Display Selection" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" Margin="0,8,0,8"/>
            <Border Background="{ThemeResource CardBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,24">
                <StackPanel>
                    <!-- Option 1: Active Monitor -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B0;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtActiveMonitor" Text="Active Monitor (Follow Cursor)" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Name="TxtActiveMonitorDesc" Text="Display notifications on the screen where your cursor is currently located" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <RadioButton Grid.Column="2" x:Name="RadActiveMonitor" GroupName="MonitorMode" Click="MonitorMode_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                    <!-- Option 2: Primary Monitor -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtPrimaryMonitor" Text="Primary Monitor Only" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Name="TxtPrimaryMonitorDesc" Text="Always display notifications on your main Windows primary display" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <RadioButton Grid.Column="2" x:Name="RadPrimaryMonitor" GroupName="MonitorMode" Click="MonitorMode_Click" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource DividerColor}" Margin="50,0,16,0"/>

                    <!-- Option 3: All Monitors -->
                    <Grid MinHeight="64" Padding="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7B5;" FontSize="18" Foreground="{ThemeResource TextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtAllMonitors" Text="All Displays Simultaneously" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}"/>
                            <TextBlock x:Name="TxtAllMonitorsDesc" Text="Glow edge animations across every connected monitor at the same time" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <RadioButton Grid.Column="2" x:Name="RadAllMonitors" GroupName="MonitorMode" Click="MonitorMode_Click" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Detected Displays Group -->
            <TextBlock x:Name="TxtDetectedDisplays" Text="Detected Displays" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextSecondary}" Margin="0,4,0,8"/>
            <StackPanel x:Name="PnlMonitors" Spacing="8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>