<UserControl x:Class="NotiGlow.UI.Controls.ToastNotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="360" d:DesignHeight="72"
             Margin="0,0,0,10"
             HorizontalAlignment="Right">
    <UserControl.RenderTransform>
        <TranslateTransform x:Name="ToastTransform" Y="0"/>
    </UserControl.RenderTransform>
    <Border x:Name="ToastBorder"
            Width="360"
            CornerRadius="10"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            Padding="14,10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Severity Icon Indicator -->
            <Border x:Name="SeverityIconContainer"
                    Grid.Column="0"
                    Width="30" Height="30"
                    CornerRadius="15"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <ui:SymbolIcon x:Name="SeverityIcon"
                               Symbol="Info24"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="TxtTitle"
                           Text="Notification"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtMessage"
                           Text="Message details go here."
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0"
                           MaxHeight="60"/>
            </StackPanel>

            <!-- Actions (Optional action button + Dismiss button) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="BtnAction"
                           Appearance="Secondary"
                           Padding="8,4"
                           FontSize="11"
                           Margin="0,0,6,0"
                           Visibility="Collapsed"
                           Click="BtnAction_Click"/>
                <ui:Button x:Name="BtnDismiss"
                           Appearance="Transparent"
                           Padding="4"
                           Height="26" Width="26"
                           Click="BtnDismiss_Click"
                           ToolTip="Dismiss">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
