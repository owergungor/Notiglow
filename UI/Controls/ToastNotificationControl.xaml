<UserControl
    x:Class="NotiGlow.UI.Controls.ToastNotificationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Right"
    Margin="0,0,0,10">
    <Border x:Name="ToastBorder"
            Width="360"
            CornerRadius="10"
            Background="{ThemeResource CardBackground}"
            BorderBrush="{ThemeResource BorderColor}"
            BorderThickness="1"
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Severity Icon Indicator -->
            <Border x:Name="SeverityIconContainer"
                    Grid.Column="0"
                    Width="30" Height="30"
                    CornerRadius="15"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <FontIcon x:Name="SeverityIcon"
                          Glyph="&#xE946;"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="TxtTitle"
                           Text="Notification"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimary}"/>
                <TextBlock x:Name="TxtMessage"
                           Text="Message details go here..."
                           FontSize="11"
                           Foreground="{ThemeResource TextSecondary}"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Close & Action Buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button x:Name="BtnAction"
                        Content="Action"
                        FontSize="11"
                        Padding="8,4"
                        Visibility="Collapsed"
                        Click="BtnAction_Click"/>
                <Button x:Name="BtnClose"
                        Padding="6,4"
                        Click="BtnClose_Click">
                    <FontIcon Glyph="&#xE711;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
