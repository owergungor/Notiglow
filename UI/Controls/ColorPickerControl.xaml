<UserControl
    x:Class="NotiGlow.UI.Controls.ColorPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <!-- Palette Header & Options -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Preset Colors" Foreground="{ThemeResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <!-- Custom Color Picker Toggle Button -->
                <Button x:Name="BtnToggleCustom" Click="BtnToggleCustom_Click" Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE790;" FontSize="12"/>
                        <TextBlock Text="Custom" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- RGB Rainbow Spectrum Option -->
                <Border x:Name="BtnRgbOption"
                        CornerRadius="6"
                        Padding="10,4"
                        BorderThickness="1.5"
                        BorderBrush="#FFFFFF"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF004D" Offset="0.0"/>
                            <GradientStop Color="#FFFF7A00" Offset="0.2"/>
                            <GradientStop Color="#FFFFD600" Offset="0.4"/>
                            <GradientStop Color="#FF00E676" Offset="0.6"/>
                            <GradientStop Color="#FF00E5FF" Offset="0.8"/>
                            <GradientStop Color="#FF7C3AED" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="#FFFFFF"/>
                        <TextBlock Text="RGB Spectrum" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        <TextBlock x:Name="TxtRgbCheck" Text=" ✓" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Preset Palette Grid -->
        <GridView x:Name="PresetPalette"
                  SelectionMode="None"
                  IsItemClickEnabled="False"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
        </GridView>

        <!-- Custom Color Section -->
        <Border x:Name="PnlCustomHex"
                Visibility="Collapsed"
                Background="{ThemeResource CardBackgroundSecondary}"
                BorderBrush="{ThemeResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,4,0,8">
            <StackPanel Spacing="10">
                <ColorPicker x:Name="NativeColorPicker"
                             ColorSpectrumShape="Box"
                             IsColorChannelTextInputVisible="False"
                             IsHexInputVisible="False"
                             IsAlphaEnabled="False"
                             ColorChanged="NativeColorPicker_ColorChanged"/>

                <!-- Hex input and Copy -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ColorPreviewBorder"
                            Grid.Column="0"
                            CornerRadius="6"
                            Height="34"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource BorderColor}">
                        <Border.Background>
                            <SolidColorBrush x:Name="ColorPreviewBrush" Color="#FF5865F2"/>
                        </Border.Background>
                    </Border>

                    <TextBox Grid.Column="2" x:Name="HexInput" Text="#5865F2" TextChanged="HexInput_TextChanged" VerticalAlignment="Center"/>
                    <Button Grid.Column="4" x:Name="BtnCopyHex" Click="BtnCopyHex_Click" VerticalAlignment="Center" Padding="8,6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
