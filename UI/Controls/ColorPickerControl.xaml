<UserControl x:Class="GlowBorder.UI.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="380" d:DesignWidth="360">
    <StackPanel>
        <!-- Preset Color Palette Grid (6x2 Grid) -->
        <TextBlock Text="Glow Color Palette" Foreground="{DynamicResource TextPrimary}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
        <UniformGrid x:Name="PresetPalette" Columns="6" Margin="0,0,0,12" />

        <!-- Collapsible Custom Color Toggle -->
        <ui:Button x:Name="BtnToggleCustom" Appearance="Secondary" FontSize="12" Padding="10,6" Click="BtnToggleCustom_Click" HorizontalAlignment="Left" Margin="0,2,0,8" ToolTip="Custom Hex Color Picker">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Color24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Custom Hex Color..." VerticalAlignment="Center"/>
            </StackPanel>
        </ui:Button>

        <!-- Custom Color Panel (Interactive Color Canvas & Hue Slider) -->
        <Border x:Name="PnlCustomHex" Visibility="Collapsed" Background="{DynamicResource CardBackgroundSecondary}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4,0,8">
            <StackPanel>
                <!-- Saturation / Value Canvas -->
                <Grid Height="130" Margin="0,0,0,10">
                    <Grid x:Name="SatValCanvas" Background="Transparent" ClipToBounds="True" PreviewMouseLeftButtonDown="SatValCanvas_MouseLeftButtonDown" MouseLeftButtonDown="SatValCanvas_MouseLeftButtonDown" MouseLeftButtonUp="SatValCanvas_MouseLeftButtonUp" PreviewMouseMove="SatValCanvas_MouseMove" MouseMove="SatValCanvas_MouseMove">
                        <!-- Layer 1: Pure Hue -->
                        <Rectangle x:Name="RectPureHue" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <SolidColorBrush x:Name="HueBaseBrush" Color="#FF0000"/>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Layer 2: White Horizontal Gradient (Saturation) -->
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <!-- Layer 3: Black Vertical Gradient (Brightness/Value) -->
                        <Rectangle IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#FF000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- Thumb selector -->
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SatValThumb" Width="14" Height="14" Canvas.Left="0" Canvas.Top="0" Stroke="#FFFFFF" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.6"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- Hue Rainbow Slider -->
                <TextBlock Text="Hue" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Border Height="10" CornerRadius="5" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFFF0000" Offset="0.00"/>
                                <GradientStop Color="#FFFFFF00" Offset="0.17"/>
                                <GradientStop Color="#FF00FF00" Offset="0.33"/>
                                <GradientStop Color="#FF00FFFF" Offset="0.50"/>
                                <GradientStop Color="#FF0000FF" Offset="0.67"/>
                                <GradientStop Color="#FFFF00FF" Offset="0.83"/>
                                <GradientStop Color="#FFFF0000" Offset="1.00"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Slider x:Name="SldHue" Minimum="0" Maximum="360" Value="0" ValueChanged="SldHue_ValueChanged" Background="Transparent">
                        <Slider.Template>
                            <ControlTemplate TargetType="{x:Type Slider}">
                                <Grid VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Grid Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                        <Grid Background="Transparent"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Focusable="False" SnapsToDevicePixels="True">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Grid Width="20" Height="20" Background="Transparent">
                                                            <Ellipse x:Name="HueThumbEllipse"
                                                                     Width="16"
                                                                     Height="16"
                                                                     Fill="#FFFFFF"
                                                                     Stroke="#202020"
                                                                     StrokeThickness="2"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center">
                                                                <Ellipse.Effect>
                                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.5" Color="#000000"/>
                                                                </Ellipse.Effect>
                                                            </Ellipse>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HueThumbEllipse" Property="Width" Value="18"/>
                                                                <Setter TargetName="HueThumbEllipse" Property="Height" Value="18"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                </Grid>

                <!-- Color Code & Preview Row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="6" Height="34" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" ToolTip="Current Color Preview">
                        <Border.Background>
                            <SolidColorBrush x:Name="ColorPreviewBrush" Color="#FF5865F2"/>
                        </Border.Background>
                    </Border>

                    <ui:TextBox Grid.Column="2" x:Name="HexInput" Text="#5865F2" TextChanged="HexInput_TextChanged" VerticalAlignment="Center"/>

                    <ui:Button Grid.Column="4" x:Name="BtnCopyHex" Icon="{ui:SymbolIcon Copy24}" Appearance="Secondary" Click="BtnCopyHex_Click" ToolTip="Copy Hex Code" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
