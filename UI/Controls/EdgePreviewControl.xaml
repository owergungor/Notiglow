<UserControl
    x:Class="NotiGlow.UI.Controls.EdgePreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="8" Background="{ThemeResource CardBackgroundSecondary}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1">
        <Grid x:Name="PreviewGrid">
            <!-- Simulated Screen Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="LIVE PREVIEW" Foreground="{ThemeResource TextSecondary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="Screen ambient edge glow simulation" Foreground="{ThemeResource TextMuted}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Base Preview Layer -->
            <Grid x:Name="PrevBaseGlowLayer" Opacity="1">
                <!-- Preview Top Edge -->
                <Rectangle x:Name="PrevTopEdge" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="15">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="PrevTopGradientBrush" StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop x:Name="PTop0" Offset="0" Color="#FF5865F2"/>
                            <GradientStop x:Name="PTop1" Offset="1" Color="#005865F2"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Preview Bottom Edge -->
                <Rectangle x:Name="PrevBottomEdge" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="15">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="PrevBottomGradientBrush" StartPoint="0.5,1" EndPoint="0.5,0">
                            <GradientStop x:Name="PBottom0" Offset="0" Color="#FF5865F2"/>
                            <GradientStop x:Name="PBottom1" Offset="1" Color="#005865F2"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Preview Left Edge -->
                <Rectangle x:Name="PrevLeftEdge" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="15">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="PrevLeftGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop x:Name="PLeft0" Offset="0" Color="#FF5865F2"/>
                            <GradientStop x:Name="PLeft1" Offset="1" Color="#005865F2"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Preview Right Edge -->
                <Rectangle x:Name="PrevRightEdge" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="15">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="PrevRightGradientBrush" StartPoint="1,0.5" EndPoint="0,0.5">
                            <GradientStop x:Name="PRight0" Offset="0" Color="#FF5865F2"/>
                            <GradientStop x:Name="PRight1" Offset="1" Color="#005865F2"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Inner Solid Line -->
                <Border x:Name="PrevInnerBorder" BorderThickness="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" CornerRadius="8">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="PInnerBrush" Color="#FF5865F2"/>
                    </Border.BorderBrush>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
