<UserControl
    x:Class="NotiGlow.UI.Controls.SkeletonLoadingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">
    <Grid Margin="24">
        <StackPanel Spacing="14">
            <Border Height="28" Width="220" CornerRadius="6" HorizontalAlignment="Left" Background="{ThemeResource SkeletonShimmerBase}"/>
            <Border Height="16" Width="380" CornerRadius="4" HorizontalAlignment="Left" Background="{ThemeResource SkeletonShimmerBase}"/>
            <Border Height="72" CornerRadius="10" Background="{ThemeResource SkeletonShimmerBase}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1"/>
            <Border Height="72" CornerRadius="10" Background="{ThemeResource SkeletonShimmerBase}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1"/>
            <Border Height="72" CornerRadius="10" Background="{ThemeResource SkeletonShimmerBase}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1"/>
        </StackPanel>
    </Grid>
</UserControl>
