<UserControl
    x:Class="NotiGlow.UI.Controls.AppProfileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="CardBorder"
            Margin="0,0,0,8"
            Padding="16,12"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource CardBackground}"
            BorderBrush="{ThemeResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Application Icon, Name & Details -->
            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon with Fallback -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" Background="{ThemeResource ControlBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="1">
                    <Grid>
                        <Image x:Name="ImgAppIcon" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <FontIcon x:Name="FallbackAppIcon" Glyph="&#xE71D;" FontSize="22" Foreground="{ThemeResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAppName" Text="{Binding Name, FallbackValue=Application}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtDetails" Text="4000 ms • 80% • Pulse" Foreground="{ThemeResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Column 1: Color Swatch -->
            <Border Grid.Column="1" x:Name="ColorBadge" Width="18" Height="18" CornerRadius="5" Margin="0,0,16,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{ThemeResource BorderColor}">
                <Border.Background>
                    <SolidColorBrush x:Name="ColorBadgeBrush" Color="#FF5865F2"/>
                </Border.Background>
            </Border>

            <!-- Column 2: Preview Button -->
            <Button Grid.Column="2" x:Name="BtnPreview" Click="BtnPreview_Click" Margin="0,0,6,0" VerticalAlignment="Center" Padding="8,6">
                <FontIcon Glyph="&#xE768;" FontSize="12"/>
            </Button>

            <!-- Column 3: Edit Button -->
            <Button Grid.Column="3" x:Name="BtnEdit" Click="BtnEdit_Click" Margin="0,0,6,0" VerticalAlignment="Center" Padding="8,6">
                <FontIcon Glyph="&#xE70F;" FontSize="12"/>
            </Button>

            <!-- Column 4: Copy Button -->
            <Button Grid.Column="4" x:Name="BtnDuplicate" Click="BtnDuplicate_Click" Margin="0,0,6,0" VerticalAlignment="Center" Padding="8,6">
                <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
            </Button>

            <!-- Column 5: Delete Button -->
            <Button Grid.Column="5" x:Name="BtnDelete" Click="BtnDelete_Click" Margin="0,0,12,0" VerticalAlignment="Center" Style="{StaticResource DestructiveIconButtonStyle}" AutomationProperties.Name="Remove" ToolTipService.ToolTip="Remove">
                <FontIcon Glyph="&#xE74D;" FontSize="12"/>
            </Button>

            <!-- Column 6: Toggle Enabled -->
            <ToggleSwitch Grid.Column="6" x:Name="ToggleEnabled" IsOn="True" OnContent="" OffContent="" HorizontalAlignment="Right" Toggled="ToggleEnabled_Toggled" VerticalAlignment="Center" AutomationProperties.Name="Enable App Profile"/>
        </Grid>
    </Border>
</UserControl>
