<UserControl x:Class="GlowBorder.UI.Controls.AppProfileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="95" d:DesignWidth="750">
    <ui:CardControl Margin="0,0,0,10" Padding="14,10" HorizontalAlignment="Stretch" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Column 0: Application Name & Details -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="TxtAppName" Text="Discord" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtDetails" Text="4000 ms • 80% • Pulse" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Column 1: Color Swatch -->
            <Border Grid.Column="1" x:Name="ColorBadge" Width="18" Height="18" CornerRadius="5" Margin="0,0,16,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource BorderColor}" ToolTip="App Glow Color">
                <Border.Background>
                    <SolidColorBrush x:Name="ColorBadgeBrush" Color="#FF5865F2"/>
                </Border.Background>
            </Border>

            <!-- Column 2: Preview Button -->
            <ui:Button Grid.Column="2" x:Name="BtnPreview" Content="Preview" Icon="{ui:SymbolIcon Play24}" Appearance="Secondary" Click="BtnPreview_Click" Margin="0,0,6,0" ToolTip="Preview" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>

            <!-- Column 3: Edit Button -->
            <ui:Button Grid.Column="3" x:Name="BtnEdit" Content="Edit" Icon="{ui:SymbolIcon Edit24}" Appearance="Secondary" Click="BtnEdit_Click" Margin="0,0,6,0" ToolTip="Edit" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>

            <!-- Column 4: Copy Button -->
            <ui:Button Grid.Column="4" x:Name="BtnDuplicate" Content="Copy" Icon="{ui:SymbolIcon Copy24}" Appearance="Secondary" Click="BtnDuplicate_Click" Margin="0,0,6,0" ToolTip="Copy" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>

            <!-- Column 5: Delete Button -->
            <ui:Button Grid.Column="5" x:Name="BtnDelete" Content="Delete" Icon="{ui:SymbolIcon Delete24}" Appearance="Secondary" Click="BtnDelete_Click" Margin="0,0,12,0" ToolTip="Delete" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>

            <!-- Column 6: Toggle Enabled -->
            <ui:ToggleSwitch Grid.Column="6" x:Name="ToggleEnabled" IsChecked="True" Click="ToggleEnabled_Click" VerticalAlignment="Center" ToolTip="Enable / Disable Profile"/>
        </Grid>
    </ui:CardControl>
</UserControl>
