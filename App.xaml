<Application
    x:Class="NotiGlow.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Centralized Theme Brushes (Dark Theme Defaults - Vercel Standard) -->
            <SolidColorBrush x:Key="WindowBackground" Color="#0A0A0A" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#121212" />
            <SolidColorBrush x:Key="CardBackground" Color="#171717" />
            <SolidColorBrush x:Key="CardBackgroundSecondary" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TextPrimary" Color="#EDEDED" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A1A1A1" />
            <SolidColorBrush x:Key="TextMuted" Color="#666666" />
            <SolidColorBrush x:Key="BorderColor" Color="#262626" />
            <SolidColorBrush x:Key="DividerColor" Color="#202020" />
            <SolidColorBrush x:Key="InputBackground" Color="#141414" />
            <SolidColorBrush x:Key="AccentColor" Color="#3B82F6" />
            <SolidColorBrush x:Key="ControlBackground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ControlHoverBackground" Color="#292929" />
            <SolidColorBrush x:Key="TextDisabled" Color="#444444" />
            <SolidColorBrush x:Key="ControlPressedBackground" Color="#333333" />
            <SolidColorBrush x:Key="ControlDisabledBackground" Color="#141414" />
            <SolidColorBrush x:Key="InputBorder" Color="#262626" />
            <SolidColorBrush x:Key="NavActiveBackground" Color="#222222" />
            <SolidColorBrush x:Key="NavActiveHoverBackground" Color="#2C2C2C" />
            <SolidColorBrush x:Key="NavIndicatorColor" Color="#3B82F6" />

            <!-- Slider Brushes -->
            <SolidColorBrush x:Key="SliderTrackBackground" Color="#333333" />
            <SolidColorBrush x:Key="SliderTrackHoverBackground" Color="#444444" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBorder" Color="#3B82F6" />

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="GlowCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="NavigationViewItemCornerRadius">6</CornerRadius>
            <x:Double x:Key="NavigationViewSelectionIndicatorWidth">3.5</x:Double>
            <x:Double x:Key="NavigationViewSelectionIndicatorHeight">22</x:Double>

            <!-- Global Windows 11 ToggleSwitch Style: Native WinUI 3 switch without text labels and right-aligned -->
            <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Hero UI Dialog Button Styles -->
            <Style x:Key="HeroPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AccentColor}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="HeroSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundSecondary}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>

            <Style x:Key="HeroCloseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{ThemeResource TextSecondary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>

            <!-- Destructive Icon Button Style: Neutral normally, Windows 11 critical red on PointerOver and Pressed -->
            <Style x:Key="DestructiveIconButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{ThemeResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="#C42B1C"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="#C42B1C"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="#A4261B"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="#A4261B"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Destructive ContentDialog Primary Button Style: Windows 11 critical red accent -->
            <Style x:Key="DestructiveDialogPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#C42B1C"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="#B02518"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="#B02518"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Background" Value="#991F14"/>
                                                <Setter Target="RootBorder.BorderBrush" Value="#991F14"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootBorder.Opacity" Value="0.4"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
