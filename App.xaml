<Application x:Class="NotiGlow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:animations="clr-namespace:NotiGlow.UI.Animations">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Centralized Theme Brushes (Dark Theme Defaults - Vercel Standard) -->
            <SolidColorBrush x:Key="WindowBackground" Color="#0A0A0A" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#121212" />
            <SolidColorBrush x:Key="CardBackground" Color="#171717" />
            <SolidColorBrush x:Key="CardBackgroundSecondary" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TextPrimary" Color="#EDEDED" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A1A1A1" />
            <SolidColorBrush x:Key="TextMuted" Color="#666666" />
            <SolidColorBrush x:Key="BorderColor" Color="#262626" />
            <SolidColorBrush x:Key="DividerColor" Color="#202020" />
            <SolidColorBrush x:Key="InputBackground" Color="#141414" />
            <SolidColorBrush x:Key="AccentColor" Color="#3B82F6" />
            <SolidColorBrush x:Key="ControlBackground" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ControlHoverBackground" Color="#292929" />
            <SolidColorBrush x:Key="GlassOverlay" Color="#00000000" />
            <SolidColorBrush x:Key="GlassBorder" Color="#262626" />
            <SolidColorBrush x:Key="TextDisabled" Color="#444444" />
            <SolidColorBrush x:Key="ControlPressedBackground" Color="#333333" />
            <SolidColorBrush x:Key="ControlDisabledBackground" Color="#141414" />
            <SolidColorBrush x:Key="InputBorder" Color="#262626" />
            <SolidColorBrush x:Key="NavActiveBackground" Color="#222222" />
            <SolidColorBrush x:Key="NavActiveHoverBackground" Color="#2C2C2C" />
            <SolidColorBrush x:Key="NavIndicatorColor" Color="#3B82F6" />

            <!-- Built-in NavigationView Selection & Hover Overrides (Eliminates sharp rectangular selection/hover boxes from Wpf.Ui built-in template) -->
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedLeftFluent" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />

            <!-- Slider Brushes (Theme Adaptable) -->
            <SolidColorBrush x:Key="SliderTrackBackground" Color="#333333" />
            <SolidColorBrush x:Key="SliderTrackHoverBackground" Color="#444444" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBorder" Color="#3B82F6" />

            <!-- Global Style Overrides for Readability & Windows 11 Fluent Aesthetic -->
            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="GlowCornerRadius">0</CornerRadius>

            <Style TargetType="{x:Type ui:TextBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>

            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Fluent/Apple ScrollBar Style (Direct Opacity Animation, 100% DependencyObject Crash-Proof) -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="8"/>
                        <Setter Property="MinWidth" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True" HorizontalAlignment="Center">
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Border x:Name="ThumbBorder"
                                                                    CornerRadius="4"
                                                                    Width="6"
                                                                    Background="{DynamicResource TextMuted}"
                                                                    Opacity="0.45"
                                                                    SnapsToDevicePixels="True"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.85"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="8"/>
                        <Setter Property="MinHeight" Value="8"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="True">
                                        <Track x:Name="PART_Track" IsDirectionReversed="False" VerticalAlignment="Center">
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb">
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Border x:Name="ThumbBorder"
                                                                    CornerRadius="4"
                                                                    Height="6"
                                                                    Background="{DynamicResource TextMuted}"
                                                                    Opacity="0.45"
                                                                    SnapsToDevicePixels="True"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.85"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1.0"/>
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Hero UI / Modern Rounded ToolTip Style -->
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToolTip}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.25" Color="#000000"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hero UI Dialog Primary Button Style -->
            <Style x:Key="HeroPrimaryButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hero UI Dialog Secondary Button Style -->
            <Style x:Key="HeroSecondaryButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundSecondary}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlPressedBackground}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Hero UI Close Button Style -->
            <Style x:Key="HeroCloseButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlPressedBackground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent Rounded ComboBoxItem Style -->
            <Style TargetType="{x:Type ComboBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="MinHeight" Value="34"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                            <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent Rounded ComboBox Style -->
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,0,32,0"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid x:Name="MainGrid" VerticalAlignment="Center">
                                <ToggleButton x:Name="ToggleButton" 
                                              Focusable="False" 
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="Border" 
                                                    CornerRadius="8" 
                                                    Background="{DynamicResource ControlBackground}" 
                                                    BorderBrush="{DynamicResource BorderColor}" 
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=MainGrid}"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                          Margin="0,4,0,4">
                                        <Border x:Name="DropDownBorder"
                                                CornerRadius="10"
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                                            </Border.Effect>
                                            <ScrollViewer SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent Theme ComboBox Style (Padding="18,8,18,8", Width=150, Height=32 vertically centered with slider & card) -->
            <Style x:Key="ThemeComboBoxStyle" TargetType="{x:Type ComboBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Width" Value="150"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,8,18,8"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid x:Name="MainGrid" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" VerticalAlignment="Center">
                                <ToggleButton x:Name="ToggleButton" 
                                              Focusable="False" 
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              VerticalAlignment="Stretch"
                                              HorizontalAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="Border" 
                                                    CornerRadius="8" 
                                                    Background="{DynamicResource InputBackground}" 
                                                    BorderBrush="{DynamicResource BorderColor}" 
                                                    BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="28"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:SymbolIcon Grid.Column="1" Symbol="ChevronDown24" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       PlacementTarget="{Binding ElementName=MainGrid}"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="175"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                          Margin="0,4,0,4">
                                        <Border x:Name="DropDownBorder"
                                                CornerRadius="10"
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                Padding="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                                            </Border.Effect>
                                            <ScrollViewer SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Segmented Theme Switcher RadioButton Style (Reference: 21st.dev/@ncdai/components/theme-switcher-1) -->
            <Style x:Key="SegmentedThemeRadioButtonStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="Bd"
                                    CornerRadius="6"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Sliding Theme Switcher RadioButton Style (Used with sliding pill background) -->
            <Style x:Key="SlidingThemeRadioButtonStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Padding" Value="14,6"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="Bd"
                                    CornerRadius="6"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Color Theme Chip RadioButton Style (13 Color Themes) -->
            <Style x:Key="ColorThemeChipRadioButtonStyle" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border x:Name="Bd"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBackground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Modern Windows 11 Fluent Theme ToggleButton Style -->
            <Style x:Key="ThemeToggleButtonStyle" TargetType="{x:Type ToggleButton}">
                <Setter Property="animations:ButtonPressAnimationBehavior.IsEnabled" Value="True"/>
                <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="18,8,18,8"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="MinWidth" Value="75"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="Bd"
                                    CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent Rounded Slider Style -->
            <Style TargetType="{x:Type Slider}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="MinHeight" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
                <Setter Property="Focusable" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Slider}">
                            <Grid x:Name="SliderRoot" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <!-- Inactive Track Bar (4px height, continuous full width) -->
                                <Border x:Name="TrackBackground"
                                        Height="4"
                                        CornerRadius="2"
                                        Background="{DynamicResource SliderTrackBackground}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        IsHitTestVisible="False"/>

                                <Track x:Name="PART_Track" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                      Focusable="False"
                                                      IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                    <Grid Background="Transparent">
                                                        <Border x:Name="ActiveTrack"
                                                                Height="4"
                                                                CornerRadius="2"
                                                                Background="{DynamicResource AccentColor}"
                                                                VerticalAlignment="Center"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                      Focusable="False"
                                                      IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                    <Grid Background="Transparent"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Focusable="False" SnapsToDevicePixels="True">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Grid Width="20" Height="20" Background="Transparent">
                                                        <Ellipse x:Name="ThumbEllipse"
                                                                 Width="14"
                                                                 Height="14"
                                                                 Fill="{DynamicResource SliderThumbBackground}"
                                                                 Stroke="{DynamicResource SliderThumbBorder}"
                                                                 StrokeThickness="2.5"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35" Color="#000000"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbEllipse" Property="Width" Value="16"/>
                                                            <Setter TargetName="ThumbEllipse" Property="Height" Value="16"/>
                                                            <Setter TargetName="ThumbEllipse" Property="StrokeThickness" Value="3"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbEllipse" Property="Width" Value="16"/>
                                                            <Setter TargetName="ThumbEllipse" Property="Height" Value="16"/>
                                                            <Setter TargetName="ThumbEllipse" Property="Fill" Value="{DynamicResource AccentColor}"/>
                                                            <Setter TargetName="ThumbEllipse" Property="Stroke" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TrackBackground" Property="Background" Value="{DynamicResource SliderTrackHoverBackground}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ui:CardControl}">
                <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:CardControl}">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Grid x:Name="CardGrid" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left Slot: Header (Title + Description TextBlock) -->
                                    <ContentPresenter x:Name="HeaderContent"
                                                      Grid.Column="0"
                                                      Content="{TemplateBinding Header}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Stretch"/>
                                                      
                                    <!-- Right Slot: Content (Action Control / ToggleSwitch / ComboBox) -->
                                    <ContentPresenter x:Name="BodyContent"
                                                      Grid.Column="1"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Right"
                                                      Margin="20,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Header" Value="{x:Null}">
                                    <Setter TargetName="HeaderContent" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="BodyContent" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="BodyContent" Property="Grid.ColumnSpan" Value="2"/>
                                    <Setter TargetName="BodyContent" Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter TargetName="BodyContent" Property="Margin" Value="0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent Windows 11 Task Manager Style NavigationViewItem Template -->
            <ControlTemplate x:Key="NotiGlowNavigationViewItemTemplate" TargetType="{x:Type ui:NavigationViewItem}">
                <Grid x:Name="ItemGrid" Height="40" Background="Transparent" ClipToBounds="True">
                    <!-- Windows 11 Task Manager Style Item Surface (No Border / No Glow) -->
                    <Border x:Name="ItemBorder"
                            CornerRadius="16"
                            Margin="0,0,12,0"
                            Background="{TemplateBinding Background}"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True">
                        <Grid IsHitTestVisible="False">
                            <!-- Windows 11 Task Manager Left Slim Vertical Indicator Bar (3x24px) -->
                            <Border x:Name="ActiveIndicator"
                                    Width="3"
                                    Height="24"
                                    CornerRadius="1.5"
                                    Margin="2,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource NavIndicatorColor}"
                                    Opacity="0"
                                    Visibility="Collapsed"/>

                            <!-- Icon Presenter (Centered in collapsed mode, aligned left in expanded mode) -->
                            <ContentPresenter x:Name="IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              Width="24"
                                              Height="24"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <!-- Content Presenter (Label) -->
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="46,0,8,0"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="13"/>
                        </Grid>
                    </Border>
                </Grid>

                <ControlTemplate.Triggers>
                    <!-- Collapsed Sidebar (Compact Mode): Perfectly Centered Icons & Tooltip -->
                    <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}" Value="False">
                        <Setter TargetName="ItemGrid" Property="Width" Value="40"/>
                        <Setter TargetName="ItemGrid" Property="HorizontalAlignment" Value="Center"/>
                        <Setter TargetName="ItemBorder" Property="Margin" Value="0"/>
                        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="IconPresenter" Property="HorizontalAlignment" Value="Center"/>
                        <Setter TargetName="IconPresenter" Property="Margin" Value="0"/>
                        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                    </DataTrigger>
                    <Trigger Property="IsPaneOpen" Value="False">
                        <Setter TargetName="ItemGrid" Property="Width" Value="40"/>
                        <Setter TargetName="ItemGrid" Property="HorizontalAlignment" Value="Center"/>
                        <Setter TargetName="ItemBorder" Property="Margin" Value="0"/>
                        <Setter TargetName="ContentPresenter" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="IconPresenter" Property="HorizontalAlignment" Value="Center"/>
                        <Setter TargetName="IconPresenter" Property="Margin" Value="0"/>
                        <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
                    </Trigger>

                    <!-- Inactive Items: Muted Text & Normal Weight -->
                    <Trigger Property="IsActive" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </Trigger>

                    <!-- Mouse Over Trigger (Inactive Items: Subtle Rounded Hover Highlight) -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsActive" Value="False"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                    </MultiTrigger>

                    <!-- Active (Selected) Navigation Item Trigger: Single Selection Overlay in MainWindow renders background and indicator -->
                    <Trigger Property="IsActive" Value="True">
                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0"/>
                        <Setter TargetName="ItemBorder" Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>

                    <!-- Active + Mouse Over Trigger: Maintain single overlay visual without duplicate layers -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsActive" Value="True"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="ActiveIndicator" Property="Opacity" Value="0"/>
                        <Setter TargetName="ItemBorder" Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- Fluent Windows 11 Task Manager Style NavigationViewItem Style -->
            <Style TargetType="{x:Type ui:NavigationViewItem}">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Margin" Value="6,2,6,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="IsPaneOpen" Value="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type ui:NavigationView}}}"/>
                <Setter Property="Template" Value="{StaticResource NotiGlowNavigationViewItemTemplate}"/>
                <Style.Triggers>
                    <Trigger Property="IsPaneOpen" Value="False">
                        <Setter Property="Width" Value="40"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Fluent Full-Card Selection RadioButton Style (No Bullet Circle, Ambient Card Glow Outline) -->
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid x:Name="TemplateRoot" Background="Transparent" HorizontalAlignment="Stretch">
                                <!-- Ambient Glow & Border Highlight Frame -->
                                <Border x:Name="GlowBorder"
                                        CornerRadius="12"
                                        Margin="-1"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1.5"
                                        SnapsToDevicePixels="True"
                                        HorizontalAlignment="Stretch">
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Hover State (Unchecked) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GlowBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="GlowBorder" Property="Opacity" Value="0.6"/>
                                </Trigger>

                                <!-- Checked (Selected) State: Full Card Accent Outline & Ambient Glow -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="GlowBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="GlowBorder" Property="Opacity" Value="1.0"/>
                                    <Setter TargetName="GlowBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#5865F2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent Full-Card Selection CheckBox Style (No Square Box, Ambient Card Glow Outline) -->
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid x:Name="TemplateRoot" Background="Transparent" HorizontalAlignment="Stretch">
                                <!-- Ambient Glow & Border Highlight Frame -->
                                <Border x:Name="GlowBorder"
                                        CornerRadius="12"
                                        Margin="-1"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1.5"
                                        SnapsToDevicePixels="True"
                                        HorizontalAlignment="Stretch">
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Hover State (Unchecked) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GlowBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="GlowBorder" Property="Opacity" Value="0.6"/>
                                </Trigger>

                                <!-- Checked (Selected) State: Full Card Accent Outline & Ambient Glow -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="GlowBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="GlowBorder" Property="Opacity" Value="1.0"/>
                                    <Setter TargetName="GlowBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#5865F2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Apple-inspired ToggleSwitch Style (Reference: ui.unlumen.com/components/apple-switch & Apple HIG) -->
            <Style TargetType="{x:Type ui:ToggleSwitch}">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="MinWidth" Value="48"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="Width" Value="48"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                            <ControlTemplate.Resources>
                                <CubicEase x:Key="AppleEase" EasingMode="EaseOut"/>
                                <Storyboard x:Key="ToggleOnAnim">
                                    <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.15" EasingFunction="{StaticResource AppleEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="ActiveTrack" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15" EasingFunction="{StaticResource AppleEase}"/>
                                </Storyboard>
                                <Storyboard x:Key="ToggleOffAnim">
                                    <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource AppleEase}"/>
                                    <DoubleAnimation Storyboard.TargetName="ActiveTrack" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" EasingFunction="{StaticResource AppleEase}"/>
                                </Storyboard>
                                <Storyboard x:Key="ThumbPressAnim">
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.08" EasingFunction="{StaticResource AppleEase}"/>
                                </Storyboard>
                                <Storyboard x:Key="ThumbReleaseAnim">
                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.08" EasingFunction="{StaticResource AppleEase}"/>
                                </Storyboard>
                            </ControlTemplate.Resources>
                            <Grid x:Name="TemplateRoot" Width="48" Height="26" Background="Transparent" SnapsToDevicePixels="True">
                                <!-- Apple Switch Pill Track (Inactive State) -->
                                <Border x:Name="SwitchTrack"
                                        Width="48"
                                        Height="26"
                                        CornerRadius="13"
                                        Background="{DynamicResource InputBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"/>

                                <!-- Active Track Overlay (Synchronously cross-fades with thumb movement) -->
                                <Border x:Name="ActiveTrack"
                                        Width="48"
                                        Height="26"
                                        CornerRadius="13"
                                        Background="{DynamicResource AccentColor}"
                                        BorderBrush="{DynamicResource AccentColor}"
                                        BorderThickness="1"
                                        Opacity="0.0"
                                        IsHitTestVisible="False"/>

                                <!-- Inner Grid Containing Disc Thumb -->
                                <Grid x:Name="TrackInnerGrid" Width="48" Height="26">
                                    <!-- Apple Pure White Disc Thumb (22x22, CornerRadius 11) with Soft Drop Shadow -->
                                    <Border x:Name="SwitchThumb"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="2,0,0,0"
                                            Background="#FFFFFF">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="ThumbScale" ScaleX="1.0" ScaleY="1.0"/>
                                                <TranslateTransform x:Name="ThumbTranslate" X="0" Y="0"/>
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25" Color="#000000"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="BeginToggleOn" Storyboard="{StaticResource ToggleOnAnim}" HandoffBehavior="SnapshotAndReplace"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard x:Name="BeginToggleOff" Storyboard="{StaticResource ToggleOffAnim}" HandoffBehavior="SnapshotAndReplace"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="BeginThumbPress" Storyboard="{StaticResource ThumbPressAnim}" HandoffBehavior="SnapshotAndReplace"/>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard x:Name="BeginThumbRelease" Storyboard="{StaticResource ThumbReleaseAnim}" HandoffBehavior="SnapshotAndReplace"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Apple-inspired Modern Select / ComboBox Style -->
